            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "If $x(t)\\leftrightarrow X(j\\omega)$ and $y(t)=x(t-5)$, what is $|Y(j\\omega)|$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-j5\\omega}X(j\\omega)$",
