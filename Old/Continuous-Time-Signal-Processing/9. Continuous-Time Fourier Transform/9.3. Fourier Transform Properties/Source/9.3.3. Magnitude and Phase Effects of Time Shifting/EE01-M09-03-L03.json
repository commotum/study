                    "block_type": "paragraph",
                    "text": "$5|X(j\\omega)|$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$|X(j\\omega)|$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$|X(j\\omega-5)|$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$1/|X(j\\omega)|$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "C"
            ],
            "correct_answer": "$|X(j\\omega)|$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "A time delay multiplies the Fourier transform by a complex exponential.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "Y(j\\omega)=e^{-j5\\omega}X(j\\omega)",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "That factor has unit magnitude, so taking the magnitude removes it and leaves the spectrum unchanged.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "|Y(j\\omega)|=|e^{-j5\\omega}|\\,|X(j\\omega)|=|X(j\\omega)|",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "So the magnitude spectrum is $|X(j\\omega)|$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "If $|X(j\\omega)|=\\dfrac{1}{\\sqrt{1+\\omega^2}}$ and $y(t)=x(t+3)$, what is $|Y(j\\omega)|$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{1}{\\sqrt{1+\\omega^2}}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{j3\\omega}\\dfrac{1}{\\sqrt{1+\\omega^2}}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{1}{\\sqrt{1+(\\omega+3)^2}}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\sqrt{1+\\omega^2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{3}{\\sqrt{1+\\omega^2}}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\dfrac{1}{\\sqrt{1+\\omega^2}}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "An advance is still a time shift, so rewrite it as $y(t)=x(t-t_0)$ with $t_0=-3$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "Y(j\\omega)=e^{j3\\omega}X(j\\omega)",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "The factor $e^{j3\\omega}$ has unit magnitude, so the magnitude spectrum does not change.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "|Y(j\\omega)|=|X(j\\omega)|=\\dfrac{1}{\\sqrt{1+\\omega^2}}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "So the correct magnitude is the same as the original one.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
