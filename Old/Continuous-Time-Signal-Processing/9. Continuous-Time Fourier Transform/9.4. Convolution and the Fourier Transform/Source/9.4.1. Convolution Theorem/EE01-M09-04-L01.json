            "correct_answer": "$y(t)=\\int_{-\\infty}^{\\infty}m(\\tau)n(t-\\tau)\\,d\\tau$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The compact notation $y(t)=m(t)*n(t)$ expands to the standard convolution integral with one signal written as $m(\\tau)$ and the other shifted to $n(t-\\tau)$.",
                "latex": "",
                "image_slot_id": ""
