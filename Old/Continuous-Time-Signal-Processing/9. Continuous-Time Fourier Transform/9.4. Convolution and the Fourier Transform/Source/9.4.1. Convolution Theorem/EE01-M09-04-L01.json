                "block_type": "display-math",
                "text": "",
                "latex": "y(t)=\\int_{-\\infty}^{\\infty}m(\\tau)n(t-\\tau)\\,d\\tau",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "That is the time-domain convolution form. The other choices are pointwise multiplication, subtraction, a correlation-like shift, or the Fourier-domain product.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
