              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)=p(t)*q(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$Y(j\\omega)=P(j\\omega)Q(j\\omega)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "D"
            ],
            "correct_answer": "$y(t)=p(t)*q(t)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The integral already has the standard convolution pattern: one signal is written as $p(\\tau)$, the other is shifted to $q(t-\\tau)$, and the result is integrated over $\\tau$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "y(t)=p(t)*q(t)",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "So the compact time-domain convolution notation is $y(t)=p(t)*q(t)$. The other choices are pointwise multiplication, a correlation-like shift, a sum, or the Fourier-domain product.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
