            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given $y(t)=\\int_{-\\infty}^{\\infty}p(\\tau)q(t-\\tau)\\,d\\tau$, which option is the matching compact time-domain convolution notation?",
