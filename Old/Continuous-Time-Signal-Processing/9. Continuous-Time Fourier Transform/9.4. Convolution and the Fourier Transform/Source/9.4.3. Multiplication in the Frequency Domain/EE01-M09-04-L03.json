                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$2e^{-j\\pi/5}e^{j\\omega/4}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$2e^{-j\\pi/5}e^{j\\omega/4}+3e^{j\\pi/10}e^{-j\\omega/6}$",
                    "latex": "",
