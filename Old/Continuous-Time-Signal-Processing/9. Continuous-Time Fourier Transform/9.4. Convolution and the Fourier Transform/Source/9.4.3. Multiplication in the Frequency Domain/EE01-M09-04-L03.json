                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$6e^{j(\\omega/12+\\pi/10)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$5e^{j(\\omega/12-\\pi/10)}$",
