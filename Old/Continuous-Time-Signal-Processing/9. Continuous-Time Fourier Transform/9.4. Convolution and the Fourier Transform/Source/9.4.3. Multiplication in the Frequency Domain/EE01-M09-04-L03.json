                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$4e^{j\\pi/4}e^{-j\\omega/3}+5e^{-j\\pi/6}e^{j\\omega/3}$",
