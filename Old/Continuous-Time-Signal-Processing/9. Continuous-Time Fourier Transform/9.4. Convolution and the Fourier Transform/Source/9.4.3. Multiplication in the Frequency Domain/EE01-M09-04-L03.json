            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given $X(j\\omega)=2e^{-j\\pi/5}e^{j\\omega/4}$ and $H(j\\omega)=3e^{j\\pi/10}e^{-j\\omega/6}$, what is $Y(j\\omega)=X(j\\omega)H(j\\omega)$ after simplifying?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$6e^{j(\\omega/12-\\pi/10)}$",
                    "latex": "",
                    "image_slot_id": ""
