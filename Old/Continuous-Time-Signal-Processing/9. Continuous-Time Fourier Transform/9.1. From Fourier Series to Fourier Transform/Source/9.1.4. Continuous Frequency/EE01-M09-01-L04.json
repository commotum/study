        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Compare periodic signals with periods $T = 3$ s and $T = 12$ s. Which statement is correct about the harmonic grid?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The $T = 12$ s signal has the denser harmonic grid because its harmonic spacing is smaller.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The $T = 3$ s signal has the denser harmonic grid because its harmonic spacing is smaller.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Both signals have the same harmonic spacing because the period does not affect $\\omega_0$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The $T = 3$ s signal has the denser harmonic grid because it has more harmonic coefficients.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The $T = 12$ s signal has the denser harmonic grid because increasing $T$ makes the spacing larger.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "The $T = 12$ s signal has the denser harmonic grid because its harmonic spacing is smaller.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Use $\\omega_0 = \\frac{2\\pi}{T}$. A larger period gives a smaller harmonic spacing, so the $T = 12$ s grid is denser than the $T = 3$ s grid.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
