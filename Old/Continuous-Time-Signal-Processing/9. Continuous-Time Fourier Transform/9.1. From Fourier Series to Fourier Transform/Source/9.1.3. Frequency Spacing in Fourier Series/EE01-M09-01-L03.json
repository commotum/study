                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The $T$ signal has spacing $\\omega_0/4$, so its harmonic spectrum is denser.",
