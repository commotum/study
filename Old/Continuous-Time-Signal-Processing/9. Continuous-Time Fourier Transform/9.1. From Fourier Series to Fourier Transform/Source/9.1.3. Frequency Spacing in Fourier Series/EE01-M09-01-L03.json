                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The $4T$ signal has spacing $\\omega_0/4$, so its harmonic spectrum is denser.",
