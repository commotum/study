            "correct_answer": "$\\dfrac{e^{-3s}}{s+1}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Match the signal to $x(t-a)u(t-a)$ with $a=3$ and base signal $x(t)=e^{-t}u(t)$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\mathcal{L}_+\\{e^{-(t-3)}u(t-3)\\}=e^{-3s}\\mathcal{L}_+\\{e^{-t}u(t)\\}=e^{-3s}\\frac{1}{s+1}=\\frac{e^{-3s}}{s+1}",
