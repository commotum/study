    "lesson_core_move": "Convert delayed and piecewise continuous-time signals into one-sided Laplace-domain expressions by choosing between direct integration and the time-shifting property.",
    "section_count": 4,
    "sections": [
      {
        "lesson_index": 1,
        "lesson_title": "Direct and Time-Shifting Laplace Methods",
        "section_index": 2,
        "section_title": "Finding a One-Sided Laplace Transform by Direct Integration",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Find the one-sided Laplace transform of $x(t)=(4t+1)u(t)$ and simplify it to rational form in $s$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{s+4}{s^2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{4s+1}{s^2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{s+4}{s}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{s-4}{s^2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{5}{s^2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\dfrac{s+4}{s^2}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Use the one-sided definition and split the integral over $[0,\\infty)$ into the linear and constant terms.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\mathcal{L}_+\\{(4t+1)u(t)\\}=4\\int_0^\\infty t e^{-st}\\,dt+\\int_0^\\infty e^{-st}\\,dt=\\frac{4}{s^2}+\\frac{1}{s}=\\frac{s+4}{s^2}",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Find the one-sided Laplace transform of $x(t)=(3t-2)u(t)$ and simplify it to rational form in $s$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{3-2s}{s^2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{3s-2}{s^2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{3+2s}{s^2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{3-2s}{s}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\dfrac{1}{s^2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\dfrac{3-2s}{s^2}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Direct integration gives $3$ times the transform of $t u(t)$ and $-2$ times the transform of $u(t)$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\mathcal{L}_+\\{(3t-2)u(t)\\}=3\\int_0^\\infty t e^{-st}\\,dt-2\\int_0^\\infty e^{-st}\\,dt=\\frac{3}{s^2}-\\frac{2}{s}=\\frac{3-2s}{s^2}",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
        "lesson_index": 1,
