              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$H(j\\omega)=\\int_{-\\infty}^{\\infty} 3e^{-2t}e^{-j\\omega t}\\,dt$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$H(j\\omega)=\\int_0^\\infty e^{-2t}e^{-j\\omega t}\\,dt$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$H(j\\omega)=\\int_0^\\infty 3e^{-2\\omega}e^{-j\\omega t}\\,d\\omega$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "B"
            ],
            "correct_answer": "$H(j\\omega)=\\int_0^\\infty 3e^{-2t}e^{-j\\omega t}\\,dt$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The cue is $u(t)$, so the impulse response is causal and the Fourier transform starts at $t=0$ with the kernel $e^{-j\\omega t}$. The scalar $3$ stays with $h(t)$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "H(j\\omega)=\\int_0^\\infty 3e^{-2t}e^{-j\\omega t}\\,dt",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "The lower limit moves from $-\\infty$ to $0$ because of the unit step, and the integration variable must stay $t$, not $\\omega$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given $h(t)=2e^{-(t-1)}u(t-1)$, which expression correctly sets up $H(j\\omega)$ as a Fourier transform integral?",
