                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$H(j\\omega)=\\int_1^\\infty 2e^{-(t-1)}e^{+j\\omega t}\\,dt$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$H(j\\omega)=\\int_1^\\infty e^{-(t-1)}e^{-j\\omega t}\\,dt$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$H(j\\omega)=\\int_1^\\infty 2e^{-(t-1)}e^{-j\\omega t}\\,dt$",
                    "latex": "",
