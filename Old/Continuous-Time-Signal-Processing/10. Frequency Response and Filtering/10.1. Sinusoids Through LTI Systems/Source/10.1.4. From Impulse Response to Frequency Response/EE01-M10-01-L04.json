            "correct_choice_labels": [
              "D"
            ],
            "correct_answer": "$H(j\\omega)=\\int_1^\\infty 2e^{-(t-1)}e^{-j\\omega t}\\,dt$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The cue is $u(t-1)$, so the support starts at $t=1$ and the Fourier kernel stays $e^{-j\\omega t}$. Keep the coefficient $2$ attached to $h(t)$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "H(j\\omega)=\\int_1^\\infty 2e^{-(t-1)}e^{-j\\omega t}\\,dt",
