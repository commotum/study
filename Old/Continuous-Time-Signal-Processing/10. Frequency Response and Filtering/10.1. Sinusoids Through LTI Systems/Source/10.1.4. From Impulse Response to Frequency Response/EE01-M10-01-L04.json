              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$H(j\\omega)=\\int_0^\\infty 2e^{-(t-1)}e^{-j\\omega t}\\,dt$",
                    "latex": "",
                    "image_slot_id": ""
