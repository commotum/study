      {
        "lesson_index": 4,
        "lesson_title": "Frequency Response as Fourier Transform of $h(t)$",
        "section_index": 3,
        "section_title": "Computing $H(j\\omega)$ from a Simple Impulse Response",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Compute $H(j\\omega)$ for $h(t)=e^{-3t}u(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{1}{3+j\\omega}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{1}{3-j\\omega}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\int_0^{\\infty} e^{-(3+j\\omega)t}\\,dt$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{1}{3+\\omega}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\int_{-\\infty}^{\\infty} e^{-3t}e^{-j\\omega t}\\,dt$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\frac{1}{3+j\\omega}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Because $u(t)$ makes $h(t)$ causal, use the one-sided Fourier transform integral from $0$ to $\\infty$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "H(j\\omega)=\\int_0^{\\infty} e^{-3t}e^{-j\\omega t}\\,dt=\\int_0^{\\infty} e^{-(3+j\\omega)t}\\,dt=\\frac{1}{3+j\\omega}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "So $H(j\\omega)=\\frac{1}{3+j\\omega}$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Compute $H(j\\omega)$ for $h(t)=2e^{-3t}u(t)$.",
