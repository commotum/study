      {
        "lesson_index": 3,
        "lesson_title": "Frequency Response $H(j\\omega)$",
        "section_index": 3,
        "section_title": "Interpreting $H(j\\omega_0)$ as a Complex Gain",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Suppose an LTI system has $H(j4)=2e^{j\\pi/3}$. What does this mean for the response to $e^{j4t}$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The output is $y(t)=2e^{j\\pi/3}e^{j4t}$, so the input keeps frequency $4$ and is multiplied by the complex gain.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The output is a new signal with frequency $2e^{j\\pi/3}$, because the complex value becomes the output frequency.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The output is $y(t)=2e^{j4t}$, so the phase factor can be ignored.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The output is $y(t)=2e^{j\\pi/3}e^{j3t}$, so the system responds at frequency $3$ instead of $4$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The output frequency becomes $8$, because $H(j4)$ shifts the tone upward.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "The system multiplies $e^{j4t}$ by $2e^{j\\pi/3}$, so the output stays at frequency $4$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The cue is the index $4$: use the sample $H(j4)$, not a different frequency. That sample is the complex multiplier applied to the matching input $e^{j4t}$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "y(t)=H(j4)e^{j4t}=2e^{j\\pi/3}e^{j4t}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "The frequency stays $4$; only the complex gain changes.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Suppose an LTI system has $H(j5)=\\tfrac{1}{3}e^{-j\\pi/4}$. What does this mean for the response to $e^{j5t}$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The output is $y(t)=\\tfrac{1}{3}e^{-j\\pi/4}e^{j5t}$, so the same frequency $5$ is multiplied by the complex gain.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The output is a new signal with frequency $\\tfrac{1}{3}e^{-j\\pi/4}$, because the complex value becomes the output frequency.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The output is $y(t)=\\tfrac{1}{3}e^{j5t}$, so only the magnitude matters and the phase does not.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The output is $y(t)=\\tfrac{1}{3}e^{-j\\pi/4}e^{j4t}$, so the system responds at frequency $4$ instead of $5$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
