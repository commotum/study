              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The output is $y(t)=e^{j5t}$, because $H(j5)$ only describes the input, not the system.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "The system multiplies $e^{j5t}$ by $\\tfrac{1}{3}e^{-j\\pi/4}$, so the output stays at frequency $5$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The cue is the index $5$: use $H(j5)$ for the matching input $e^{j5t}$. That value is the frequency-specific complex multiplier.",
                "latex": "",
                "image_slot_id": ""
              },
              {
