            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given pole pairs $s=-1\\pm j2$, $s=2\\pm j1$, and $s=-3\\pm j4$, which classification is correct?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$s=-1\\pm j2$ and $s=-3\\pm j4$ are decaying oscillatory; $s=2\\pm j1$ is unstable oscillatory.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "All three pairs are decaying oscillatory because all three have nonzero imaginary parts.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Only $s=-1\\pm j2$ is decaying oscillatory; $s=2\\pm j1$ and $s=-3\\pm j4$ are unstable oscillatory.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$s=2\\pm j1$ is decaying oscillatory; $s=-1\\pm j2$ and $s=-3\\pm j4$ are unstable oscillatory.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$s=-1\\pm j2$ is sustained oscillatory, $s=2\\pm j1$ is decaying oscillatory, and $s=-3\\pm j4$ is non-oscillatory.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$s=-1\\pm j2$ and $s=-3\\pm j4$ are decaying oscillatory; $s=2\\pm j1$ is unstable oscillatory.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "A decaying oscillatory pair must be complex, conjugate, and have negative real part. The pairs with real parts $-1$ and $-3$ satisfy this, while the pair with real part $2$ grows for a causal LTI response.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "s=-1\\pm j2 \\Rightarrow \\sigma=-1<0,\\quad s=2\\pm j1 \\Rightarrow \\sigma=2>0,\\quad s=-3\\pm j4 \\Rightarrow \\sigma=-3<0",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the pole cases $s=-4\\pm j5$, $s=-2$, $s=\\pm j6$, and $s=1\\pm j3$, which statement correctly identifies the decaying oscillatory contributors?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Only $s=-4\\pm j5$ is decaying oscillatory; $s=-2$ is non-oscillatory, $s=\\pm j6$ is sustained oscillatory, and $s=1\\pm j3$ is unstable oscillatory.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$s=-4\\pm j5$ and $s=\\pm j6$ are both decaying oscillatory because both are complex conjugate pairs.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$s=-2$ is the only decaying oscillatory contributor because it has a negative real part.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$s=1\\pm j3$ is decaying oscillatory because its imaginary part is nonzero.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "None of the cases are decaying oscillatory because a decaying oscillation cannot come from complex poles.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "Only $s=-4\\pm j5$ is decaying oscillatory.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The pair $s=-4\\pm j5$ is complex, conjugate, and has negative real part, so it gives a decaying oscillation. The pole $s=-2$ decays without oscillating, $s=\\pm j6$ oscillates without decay, and $s=1\\pm j3$ grows because its real part is positive.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "s=-4\\pm j5 \\Rightarrow \\sigma=-4<0,\\; \\omega=5\\neq 0 \\Rightarrow \\text{decaying oscillatory}",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
