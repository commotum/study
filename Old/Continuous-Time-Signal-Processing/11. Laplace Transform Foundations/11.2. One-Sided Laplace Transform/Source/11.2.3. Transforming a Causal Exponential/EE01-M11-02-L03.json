            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "\\mathcal{L}_+\\{e^{-5t}u(t)\\}=\\frac{1}{s+5},\\qquad \\operatorname{Re}(s)>-5",
              "image_slot_id": ""
            },
            {
              "block_type": "paragraph",
              "text": "The final result is a quick recognition move: parameter substitution into the shared template and ROC transfer, not a re-derivation.",
              "latex": "",
              "image_slot_id": ""
            }
          ]
        }
      }
    ]
