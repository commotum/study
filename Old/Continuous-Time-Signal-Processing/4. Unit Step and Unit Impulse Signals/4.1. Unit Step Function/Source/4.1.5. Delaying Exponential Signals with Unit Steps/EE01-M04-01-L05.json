        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Which expression matches a signal that equals $e^{2t}$ for $1 \\le t < 5$ and $0$ elsewhere, while keeping the waveform unshifted?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{2(t-1)}u(t-1)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{2t}u(t-1)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{2t}[u(t-1)-u(t-5)]$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{2(t-1)}[u(t-1)-u(t-5)]$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{2t}[u(t+1)-u(t-5)]$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "C"
            ],
            "correct_answer": "$e^{2t}[u(t-1)-u(t-5)]$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The waveform is already written as $e^{2t}$ in global time, so the exponent stays unshifted. The finite interval comes only from the step difference.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "x(t)=e^{2t}[u(t-1)-u(t-5)]",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "A delayed form would move the time origin inside the exponential, which is not what this prompt asks for.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Which expression matches a signal that equals $e^{-3t}$ for $4 \\le t < 9$ and $0$ elsewhere, without re-anchoring the exponential?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-3(t-4)}u(t-4)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-3t}[u(t-4)-u(t-9)]$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-3(t-4)}[u(t-4)-u(t-9)]$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-3t}u(t-4)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-3t}[u(t+4)-u(t-9)]$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "B"
            ],
            "correct_answer": "$e^{-3t}[u(t-4)-u(t-9)]$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The exponential is already given as $e^{-3t}$ in global time, so it should not be re-anchored. The step difference alone gates the active interval from $t=4$ to $t=9$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "x(t)=e^{-3t}[u(t-4)-u(t-9)]",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "Any choice that shifts the exponent is turning the waveform into a delayed signal instead of a gated unshifted one.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      }
