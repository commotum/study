            "correct_answer": "$\\delta(t)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The basic unit step jumps at $t=0$, so its derivative is the unit impulse at the origin.",
                "latex": "",
                "image_slot_id": ""
