            "correct_answer": "$\\delta(t)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The derivative of $u(t)$ is tied to the jump at $t=0$, so it becomes the origin impulse $\\delta(t)$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\frac{d}{dt}u(t)=\\delta(t)",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "A shifted impulse like $\\delta(t-1)$ or $\\delta(t+1)$ would belong to a step that jumps elsewhere, and the original step is not the derivative.",
