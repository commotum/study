            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "If $x(t)$ is nonzero on $[2,10]$ and has peak amplitude $7$, what support interval and amplitude statement are correct for $x(t/2)$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The support is $[4,20]$ and the peak amplitude stays $7$.",
