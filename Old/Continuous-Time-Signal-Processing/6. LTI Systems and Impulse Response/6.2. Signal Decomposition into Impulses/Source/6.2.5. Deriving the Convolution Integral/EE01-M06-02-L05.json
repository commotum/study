            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For an LTI system, the weighted impulse component $x(\\tau)\\delta(t-\\tau)\\,d\\tau$ contributes $x(\\tau)h(t-\\tau)\\,d\\tau$ to the output. Write the full continuous superposition for $y(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "$y(t)$=$\\int$_{-$\\infty$}^{$\\infty$}$x(\\tau)$$h(t-\\tau)$\\,d$\\tau$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The component response already has the correct integrand: $x(\\tau)h(t-\\tau)$. The full output is found by adding all such contributions over the same $\\tau$-range.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "y(t)=\\int_{-\\infty}^{\\infty}x(\\tau)h(t-\\tau)\\,d\\tau",
                "image_slot_id": ""
              }
