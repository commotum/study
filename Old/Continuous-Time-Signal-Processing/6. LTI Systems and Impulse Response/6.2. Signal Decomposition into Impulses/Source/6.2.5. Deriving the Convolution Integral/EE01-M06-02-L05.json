            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "An input is written as $x(t)=\\int_{-\\infty}^{\\infty}x(\\tau)\\delta(t-\\tau)\\,d\\tau$. For an LTI system with impulse response $h(t)$, write the output $y(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "$y(t)$=$\\int$_{-$\\infty$}^{$\\infty$}$x(\\tau)$$h(t-\\tau)$\\,d$\\tau$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Each shifted impulse $\\delta(t-\\tau)$ produces $h(t-\\tau)$, and the weight $x(\\tau)$ stays attached to that response. Integrating over all $\\tau$ superposes the component responses.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "y(t)=\\int_{-\\infty}^{\\infty}x(\\tau)h(t-\\tau)\\,d\\tau",
                "image_slot_id": ""
              }
            ]
          },
