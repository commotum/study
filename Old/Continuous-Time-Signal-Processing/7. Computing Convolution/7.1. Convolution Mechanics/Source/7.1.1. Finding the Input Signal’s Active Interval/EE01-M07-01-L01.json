            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given that $\\operatorname{supp} x=[-6,-2]$, write the fixed support constraint for $x(\\tau)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "$-6\\le \\tau\\le -2$",
