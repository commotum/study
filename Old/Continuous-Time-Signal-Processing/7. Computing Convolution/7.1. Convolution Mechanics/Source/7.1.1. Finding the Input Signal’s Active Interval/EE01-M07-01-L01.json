            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "If $x(\\tau)$ is nonzero only on $-1\\le \\tau\\le 4$, write the fixed support constraint for $x(\\tau)$ that will be used when finding overlap with $h(t-\\tau)$.",
