        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "free-response",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Evaluate the step response for $x(t)=u(t)$ and $h(t)=4e^{-4t}u(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "$y(t)$=(1-$e^{-4t}$)$u(t)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $t<0$ there is no causal overlap. For $t\\ge0$, evaluate the same overlap integral from 0 to t.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "t\\ge 0:\\quad y(t)=\\int_0^t 4e^{-4(t-\\tau)}\\,d\\tau",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "4e^{-4(t-\\tau)}=4e^{-4t}e^{4\\tau}",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\begin{aligned} y(t)&=4e^{-4t}\\int_0^t e^{4\\tau}\\,d\\tau \\\\ &=4e^{-4t}\\left[\\frac{1}{4}e^{4\\tau}\\right]_0^t \\\\ &=e^{-4t}(e^{4t}-1) \\\\ &=1-e^{-4t}. \\end{aligned}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "Attach the causal unit step to include the zero-output region, so $y(t)=(1-e^{-4t})u(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "free-response",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Evaluate the step response for $x(t)=u(t)$ and $h(t)=6e^{-6t}u(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "$y(t)$=(1-$e^{-6t}$)$u(t)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The unit-step factors give zero output for $t<0$ and the overlap interval $0 \\le \\tau \\le t$ for $t\\ge0$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "t\\ge 0:\\quad y(t)=\\int_0^t 6e^{-6(t-\\tau)}\\,d\\tau",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
