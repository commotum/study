              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the signals below, which statement gives the $\\tau$-values where $x(\\tau)$$h(t - \\tau)$ is nonzero?",
