                    "latex": "0\\le \\tau\\le t \\quad \\text{for all } t",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "display-math",
