            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Reconstruct $x(t)$ when $a_0=4$, $a_1=2$, $b_1=-3$, $a_2=-1$, $b_2=5$, and $\\omega_0=3$.",
