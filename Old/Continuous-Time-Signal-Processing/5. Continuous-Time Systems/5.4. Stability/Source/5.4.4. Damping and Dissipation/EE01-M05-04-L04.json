        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given $y(t)=4e^{-2.5t}$, which statement is correct about its behavior as $t \\to \\infty$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)$ is decaying and $\\lim_{t\\to\\infty}y(t)=0$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)$ is decaying and converges to $4$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)$ is non-decaying and stays at the constant value $4$ for all $t$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)$ is non-decaying and grows to $+\\infty$ as $t\\to\\infty$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)$ is non-decaying and grows to $-\\infty$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$y(t)$ is decaying and converges to $0$ as $t\\to\\infty$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Put the response in standard form, then check the exponent sign:",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "y(t)=4e^{-2.5t}=Ke^{-at},\\qquad K=4,\\ a=2.5>0",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "Because $a>0$, the factor $e^{-2.5t}$ decays as $t\\to\\infty$, so the output stays bounded and settles at $0$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\lim_{t\\to\\infty}4e^{-2.5t}=0",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given $y(t)=-3e^{-0.8t}$, which statement is correct?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)$ is non-decaying because the negative amplitude makes it diverge to $-\\infty$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)$ is non-decaying and stays at $-3$ for all time.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)$ is decaying and converges to $0$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)$ grows without bound because the factor is effectively $e^{0.8t}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)$ is bounded but has no finite limit due to sign changes.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "C"
            ],
            "correct_answer": "$y(t)$ is decaying and converges to $0$ as $t\\to\\infty$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Again, read the response as $K e^{-at}$ and check that $a>0$:",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "y(t)=-3e^{-0.8t}=Ke^{-at},\\qquad K=-3,\\ a=0.8>0",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "The exponential decay term still drives the magnitude to zero. The sign on $K$ changes only the direction, not whether it decays.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\lim_{t\\to\\infty}-3e^{-0.8t}=0",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
        "lesson_index": 4,
        "lesson_title": "Damping and Dissipation",
        "section_index": 3,
        "section_title": "Relating Dissipation to Output Settling",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $y_1(t)=5e^{-0.6t}$ and $y_2(t)=2e^{-1.8t}$, which has stronger dissipation and reaches a neighborhood of zero sooner?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y_1(t)$, because it starts larger at $t=0$ and therefore settles faster.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y_2(t)$, because its decay coefficient is larger and the exponential envelope shrinks faster.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y_1(t)$, because $-0.6$ is closer to zero and therefore gives stronger dissipation than $-1.8$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Both $y_1(t)$ and $y_2(t)$ settle at the same speed because both are exponential responses of the form $K e^{-at}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y_1(t)$, because its numerator is larger and this always dominates settling behavior.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "B"
            ],
            "correct_answer": "$y_2(t)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Both are in the form $K e^{-at}$, so compare $a$. Here $a_1=0.6$ and $a_2=1.8$, and $1.8>0.6$, so $y_2$ decays faster and reaches settling sooner.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $y_1(t)=3e^{-t/2}$ and $y_2(t)=3e^{-t/5}$, which response settles first as $t\\to\\infty$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
