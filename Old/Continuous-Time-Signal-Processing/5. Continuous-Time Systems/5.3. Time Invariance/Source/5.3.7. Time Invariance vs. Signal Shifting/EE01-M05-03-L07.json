        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given the signal $x(t)$, classify $x(t-3)$ and $x(t+2)$ compared to $x(t)$ before any system is applied.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$x(t+3)$ is a delay by $3$, and $x(t-2)$ is an advance by $2$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$x(t-3)$ is delayed by $3$, while $x(t+2)$ is advanced by $2$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$x(t-3)$ and $x(t+2)$ each keep the same time placement but differ only in amplitude.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$x(t-3)$ is the system output for a delay test, and $x(t+2)$ is the unshifted input.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Time invariance is confirmed by checking whether $x(t-3)=x(t+2)$ for all $t$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "B"
            ],
            "correct_answer": "$x(t-3)$ is delayed by 3 and $x(t+2)$ is advanced by 2.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The rule is only a change of argument: a negative sign in $t-\\tau$ means a delay, and a positive sign in $t+\\tau$ means an advance. So $x(t-3)$ shifts right by 3 and $x(t+2)$ shifts left by 2.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Which is the best description of $x(t+5)$ relative to $x(t)$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It is the same waveform delayed by 5 units.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It is the same waveform advanced by 5 units, with no change in shape.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It represents the system output for input shift by $5$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It scales $x(t)$ by $5$ and flips the direction of time.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It is unchanged from $x(t)$ because only systems, not inputs, are shifted in time-invariance tests.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "B"
            ],
            "correct_answer": "$x(t+5)$ is an advance of $x(t)$ by 5 units.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The plus sign means $x(t+\\tau)$, so features occur 5 units earlier than in $x(t)$. The shape and rule remain the same; only the time placement changes.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
        "lesson_index": 7,
        "lesson_title": "Time Invariance vs. Signal Shifting",
        "section_index": 3,
        "section_title": "Comparing the Shift-Then-System and System-Then-Shift Paths",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the system $T\\{x(t)\\}=x^2(t)$, let $y(t)=T\\{x(t)\\}$. Compare the two paths for delayed input $x(t-\\tau)$. Which option is correct?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T\\{x(t-\\tau)\\}=x^2(t-\\tau)$ and $y(t-\\tau)=x^2(t-\\tau)$, so the paths match and the delay is preserved.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T\\{x(t-\\tau)\\}=x^2(t)$ and $y(t-\\tau)=x^2(t-\\tau)$; therefore the paths also match because the same $\\tau$ appears in the notation.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T\\{x(t-\\tau)\\}=x^2(t+\\tau)$ and $y(t-\\tau)=x^2(t-\\tau)$, so the output is shifted in the opposite direction.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T\\{x(t-\\tau)\\}=x^2(t-\\tau)-\\tau$ and $y(t-\\tau)=x^2(t-\\tau)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T\\{x(t-\\tau)\\}=2x^2(t-\\tau)$ and $y(t-\\tau)=x^2(t-\\tau)$; a mismatch in amplitude means the paths can still be considered equal.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "Option A",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "From the original rule $y(t)=x^2(t)$, the shift-then-system path is $T\\{x(t-\\tau)\\}=x^2(t-\\tau)$. The system-then-shift path is $y(t-\\tau)=x^2(t-\\tau)$. They are identical, so the delay is preserved.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
