        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "A proposed statement says '$y$ is input and $x$ is output' for $y(t)=\\int_0^t x(\\tau)\\,d\\tau$. Which check is best?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Reject it. The signal in the rule is $x(\\tau)$, so $x(t)$ is the input and $y(t)$ is the output, with direction $x \\rightarrow y$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Accept it, because integrals are bidirectional and can be written with either variable as input or output.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Reject it only because integrals are too hard; with this equation no input-output label is possible.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Accept it if you rewrite the system as $y(t)=F(y(t))$ and call $y$ the source and $x$ the target.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Reject it and report that both $x$ and $y$ are outputs of the rule.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$x(t)$ is the input and $y(t)$ is the output, so the proposal is incorrect.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "For a rule of the form $y(t)=\\int_0^t x(\\tau)\\,d\\tau$, the variable transformed by the rule is the one inside the integral. That is $x(t)$, so the output must be $y(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given $v(t)=\\frac{d}{dt}u(t)$ and the proposal '$u$ is output, $v$ is input', select the best judgment.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Reject it. The proposal reverses the roles; $u(t)$ is input and $v(t)$ is output, with direction $u \\rightarrow v$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Accept it, because differentiation means the derivative output can be treated as the input in the same rule.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Accept the proposal only if $\\frac{d}{dt}$ is moved to the left of $v(t)$ and read as an inverse operator.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Reject it because the equation is invalid without an explicit integration constant.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Reject it but claim no assignment is possible because $u$ and $v$ both represent signal family names.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "The correct assignment is $u(t)$ input and $v(t)$ output; the proposal is directionally reversed.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "In $v(t)=\\frac{d}{dt}u(t)$, the signal being operated on is $u(t)$. Operators change that input signal and produce the output. So $u$ cannot be output in this one-way assignment.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
