      {
        "lesson_index": 2,
        "lesson_title": "Inputs and Outputs",
        "section_index": 3,
        "section_title": "Determining the Direction of a Signal Transformation",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the rule $a(t)=\\frac{d}{dt}b(t)$, identify the input, the output, and the transformation direction.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$b(t)$ is the input, $a(t)$ is the output, with input $\\rightarrow$ output direction.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$a(t)$ is the input and $b(t)$ is the output, so the direction is output $\\rightarrow$ input.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$b(t)$ is the input but the operation is also one-way from both $a(t)$ and $b(t)$ to each other.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The integration or differentiation variable is the output, so $t$ is the output signal.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Neither variable is clearly input or output until initial conditions are provided.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "Input: $b(t)$, Output: $a(t)$, Direction: input $\\rightarrow$ output",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "In $a(t)=\\frac{d}{dt}b(t)$, $a(t)$ appears as the left-hand signal and is therefore the output. The quantity inside the operator, $b(t)$, is the input, so the direction is input $\\rightarrow$ output.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $z(t)=\\int_{0}^{t} x(\\tau)\\,d\\tau$, which assignment is correct?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$x(t)$ is the input, $z(t)$ is the output, and the direction is input $\\rightarrow$ output.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The integration limit $0$ indicates $z(t)$ maps to $x(t)$, so output $\\rightarrow$ input.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Both $x(t)$ and $z(t)$ are outputs and should not be assigned input-output roles.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\tau$ is the system output because it is the integration variable shown on the right side.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$x(t)$ is the output and $z(t)$ is the input because $z$ appears before the integral sign.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "Input: $x(t)$, Output: $z(t)$, Direction: input $\\rightarrow$ output",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Even with limits, this is still a one-way system rule: $x(\\tau)$ is the signal being transformed by integration. The result is $z(t)$ on the left, so it is the output and direction stays input $\\rightarrow$ output.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
