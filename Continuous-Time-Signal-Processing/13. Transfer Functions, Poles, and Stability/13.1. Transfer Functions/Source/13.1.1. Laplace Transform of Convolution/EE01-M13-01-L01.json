            "correct_answer": "$Y(s)=X(s)H(s)=\\frac{3}{(s+2)s^2}, \\quad \\Re\\{s\\}>0$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Transform each causal factor separately, then multiply the results. The one-sided ROC is the intersection of the factor ROCs, so the product keeps $\\Re\\{s\\}>0$.",
                "latex": "",
