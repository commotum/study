      {
        "lesson_index": 5,
        "lesson_title": "Rational Transfer Functions",
        "section_index": 3,
        "section_title": "Rewriting $H(s)$ as a Quotient of Polynomials",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Rewrite $H(s)=\\frac{2}{s+1}+\\frac{3}{s+4}$ as one quotient of polynomials in $s$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{5s+11}{(s+1)(s+4)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{5}{(s+1)(s+4)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{5s+14}{(s+1)(s+4)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{5s-11}{(s+1)(s+4)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{5s+11}{s^2+4s+3}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\frac{5s+11}{(s+1)(s+4)}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Use the common denominator $(s+1)(s+4)$. Rewrite each term over that denominator, then add the numerators.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\frac{2}{s+1}+\\frac{3}{s+4}=\\frac{2(s+4)+3(s+1)}{(s+1)(s+4)}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "That gives $2(s+4)+3(s+1)=2s+8+3s+3=5s+11$, so the single quotient is $\\frac{5s+11}{(s+1)(s+4)}$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Rewrite $H(s)=\\frac{3}{s-2}+\\frac{1}{s+5}$ as one quotient of polynomials in $s$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{4s+13}{s^2+3s-10}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{4}{(s-2)(s+5)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{4s+15}{(s-2)(s+5)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{4s-13}{s^2+3s-10}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{4s+13}{s^2+2s-10}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\frac{4s+13}{s^2+3s-10}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Use the common denominator $(s-2)(s+5)$. Rewrite each term over that denominator, then combine the numerators.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
