                "text": "An LTI system has impulse response $h(t)=5e^{-t}u(t)$. What is the output when the input is $-3\\delta(t-2)$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "$-3h(t-2)$=-15e^{-(t-2)}$u(t-2)$",
            "answer_explanation_blocks": [
