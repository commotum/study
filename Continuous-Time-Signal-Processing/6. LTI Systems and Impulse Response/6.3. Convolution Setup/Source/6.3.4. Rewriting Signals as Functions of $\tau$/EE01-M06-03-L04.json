            "correct_answer": "$x(\\tau)=\\begin{cases}1, & 0\\le \\tau<1\\\\ 3-\\tau, & 1\\le \\tau\\le 3\\\\ 0, & \\text{otherwise}\\end{cases}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Rewrite every row using $\\tau$. The constant pieces stay the same, $3-t$ becomes $3-\\tau$, and each interval condition changes from $t$ to $\\tau$ without changing endpoints or inclusions.",
