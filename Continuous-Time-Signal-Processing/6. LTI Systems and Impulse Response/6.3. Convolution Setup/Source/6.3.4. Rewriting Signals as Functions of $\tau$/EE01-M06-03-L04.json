              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "x(t)=\\begin{cases}1, & 0\\le t<1\\\\ 3-t, & 1\\le t\\le 3\\\\ 0, & \\text{otherwise}\\end{cases}",
                "image_slot_id": ""
              }
            ],
            "choices": [],
