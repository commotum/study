      {
        "lesson_index": 3,
        "lesson_title": "Weighted Impulse Decomposition",
        "section_index": 4,
        "section_title": "Writing Several Weighted Impulse Components",
        "step_type": "example",
        "question_type": "free-response",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "free-response",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Using $x(\\tau)=2\\tau+1$, write the weighted impulse components at $\\tau=0$, $\\tau=1$, and $\\tau=3$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "$\\delta$(t)+3$\\delta$(t-1)+7$\\delta$(t-3)",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Evaluate the signal at each requested location.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\begin{aligned}x(0)&=2(0)+1=1\\\\x(1)&=2(1)+1=3\\\\x(3)&=2(3)+1=7\\end{aligned}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "Attach each weight to the shifted impulse at the same location and add the components.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\delta(t)+3\\delta(t-1)+7\\delta(t-3)",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "free-response",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Using $x(\\tau)=\\tau^2+1$, write the weighted impulse components at $\\tau=1$ and $\\tau=3$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "2$\\delta$(t-1)+10$\\delta$(t-3)",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Evaluate $x(\\tau)$ at the two requested locations.",
                "latex": "",
                "image_slot_id": ""
              },
              {
