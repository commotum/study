            "correct_answer": "A",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "An additive system applies the same shift to the summed input and also to each input separately. For $T[x(t)] = x(t+1)$, both sides become $x_1(t+1)+x_2(t+1)$.",
                "latex": "",
                "image_slot_id": ""
