                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = (x_1+x_2)(t-1)=x_1(t-1)+x_2(t-1)$ and $T[x_1(t)] + T[x_2(t)] = x_1(t+1)+x_2(t+1)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = x_1(t+1)+x_2(t)$ and $T[x_1(t)] + T[x_2(t)] = x_1(t+1)+x_2(t+1)$",
                    "latex": "",
