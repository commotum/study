            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the system $T[x(t)] = x(t+1)$, which expression is the correct additivity test result?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = (x_1+x_2)(t+1)=x_1(t+1)+x_2(t+1)$ and $T[x_1(t)] + T[x_2(t)] = x_1(t+1)+x_2(t+1)$",
