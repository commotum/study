            ],
            "correct_answer": "A",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "$T[x_1(t)+x_2(t)]$ applies the delay once to the summed input, giving $x_1(t-2)+x_2(t-2)$, which is the same as $T[x_1(t)] + T[x_2(t)]$.",
