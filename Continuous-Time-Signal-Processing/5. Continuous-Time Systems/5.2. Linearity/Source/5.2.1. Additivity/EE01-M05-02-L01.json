        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the system $T[x(t)] = x(t-2)$, which option correctly shows the additivity comparison for arbitrary inputs $x_1(t)$ and $x_2(t)$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = x_1(t-2)+x_2(t-2)$ and $T[x_1(t)] + T[x_2(t)] = x_1(t-2)+x_2(t-2)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = x_1(t-2)$ and $T[x_1(t)] + T[x_2(t)] = x_1(t-2)+x_2(t-2)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = x_1(t)+x_2(t)$ and $T[x_1(t)] + T[x_2(t)] = x_1(t-2)+x_2(t-2)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = x_1(t-1)+x_2(t-1)$ and $T[x_1(t)] + T[x_2(t)] = x_1(t-1)+x_2(t-1)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = x_1(t-2)+x_2(t-2)$ and $T[x_1(t)] + T[x_2(t)] = x_1(t-2)$",
                    "latex": "",
