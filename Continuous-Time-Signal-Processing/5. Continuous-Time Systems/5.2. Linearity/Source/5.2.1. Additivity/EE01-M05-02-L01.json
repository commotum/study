        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $T[x(t)] = [x(t)]^2$ with $x_1(t)=2$ and $x_2(t)=3$, compute $T[x_1(t)+x_2(t)]$ and $T[x_1(t)] + T[x_2(t)]$. Which option correctly shows additivity fails?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = T[2+3] = [5]^2 = 25$ and $T[x_1(t)] + T[x_2(t)] = 2^2 + 3^2 = 13$, so $T[x_1+x_2] \\neq T[x_1]+T[x_2]$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = 2+3=5$ and $T[x_1(t)] + T[x_2(t)] = 13$, so the two sides appear to match if you treat $5$ as the combined squared value.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = [2+3]^2 = 2^2 + 3^2 = 13$ and $T[x_1(t)] + T[x_2(t)] = 13$, so the system is additive.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = [2+3]^2 = 25$, but only compares this with $T[x_1(t)] = 2^2 =4$ and leaves out $T[x_2(t)]$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Compute $[2+3]^2 = (2+3)(2+3)=25$, then conclude incorrectly that the sum of separate outputs is also $25$, so $T$ is additive.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "Choice $A$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Evaluating the summed input gives $T[2+3]=5^2=25$, while separate outputs give $2^2+3^2=4+9=13$. Since these are different, the system is not additive.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $T[x(t)] = [x(t)]^2$ with $x_1(t)=t$ and $x_2(t)=-2$, pick the option that correctly reports the additivity comparison.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = [t-2]^2 = t^2-4t+4$ and $T[x_1(t)] + T[x_2(t)] = t^2 + (-2)^2 = t^2+4$, so the two sides are not equal.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = [t-2]^2 = t^2 +4$ and $T[x_1(t)] + T[x_2(t)] = t^2 -4$, so the two sides still match after a sign correction.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = t^2 + 4$ and $T[x_1(t)] + T[x_2(t)] = t^2 + 4$, so additivity holds.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Only compute $T[x_1(t)] + T[x_2(t)] = t^2 + (-2)^2 = t^2+4$ and compare this single expression to zero.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T[x_1(t)+x_2(t)] = [t-2]^2 = t^2-4t+4$, and because the form looks like an expansion result it is therefore additive by definition.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "Choice $A$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "$T[t-2] = (t-2)^2 = t^2-4t+4$. The separate-output side is $T[t] + T[-2] = t^2 + 4$. Because of the missing cross term $-4t$, the expressions do not match.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
