        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Classify whether the response $y(t)=-2 + 5e^{-3t}+0.2\\cos(5t)$ is finite under bounded physical input assumptions.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Stable (finite): constant offset, decaying exponential, and bounded cosine all stay finite, so $y(t)$ has a finite envelope.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Unstable: $e^{-3t}$ is a growing term, so the response must diverge.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Unstable: the constant offset forces unbounded accumulation in physical time.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Stable only if $t<0$, because then the cosine term is bounded and the rest is not.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Unstable because the cosine oscillation can produce divergence in magnitude when combined with the offset.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "A",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Each term stays finite: the constant is bounded by $2$, the exponential factor decays because the exponent is negative, and $0.2\\cos(5t)$ is bounded by $\\pm 0.2$. Therefore $y(t)$ has a finite global envelope.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Classify whether the response $y(t)=7 + e^{2t} - 0.6\\cos(t)$ is finite under bounded physical input assumptions.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Stable (finite): the bounded cosine and constant dominate and limit the response for all time.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Unstable: exponential growth in $e^{2t}$ forces the response to become unbounded even though other terms are bounded.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Unstable: any nonzero constant term causes unbounded accumulation in physical systems.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Unstable only when cosine has phase shift; with no phase shift it remains stable.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Stable if $y(t)$ is interpreted as a physical energy response because cosine is periodic.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "B"
            ],
            "correct_answer": "B",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Although the cosine is bounded and the constant is finite, $e^{2t}$ grows without bound as $t\\to\\infty$, so no finite global bound can contain $y(t)$ for all time.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
        "lesson_index": 3,
        "lesson_title": "Stable Physical Systems",
        "section_index": 3,
        "section_title": "Interpreting Bounded Responses to Sustained Inputs",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $\\\\dot y +4y=x(t)$, $y(0)=0$, and $|x(t)|\\\\le2$, choose the correct stability conclusion.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Stable: the response is bounded, and one valid envelope is $|y(t)| \\\\le 1/2$ for all $t \\ge 0$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Unstable: bounded inputs to this system always produce unbounded outputs.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Stable only if the input is eventually zero, not merely bounded.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Unstable because $e^{-4t}y(0)$ grows without bound before decaying.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Stable, but only if we check output behavior experimentally for a finite window.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "Stable with finite bound; one valid bound is $|y(t)|\\\\le \\frac{1}{2}$.",
            "answer_explanation_blocks": [
              {
                "block_type": "display-math",
                "text": "",
                "latex": "y(t)=e^{-4t}y(0)+\\\\int_0^t e^{-4(t-\\\\tau)}x(\\\\tau)\\\\,d\\\\tau =\\\\int_0^t e^{-4(t-\\\\tau)}x(\\\\tau)\\\\,d\\\\tau",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "Since $y(0)=0$ and $|x(\\tau)|\\\\le2$, bound the input term directly.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "|y(t)|\\\\le\\\\int_0^t e^{-4(t-\\\\tau)}|x(\\\\tau)|\\\\,d\\\\tau\\\\le2\\\\int_0^t e^{-4(t-\\\\tau)}\\\\,d\\\\tau =\\frac{1-e^{-4t}}{2}\\\\le\\frac{1}{2}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "A fixed finite envelope exists, so the output remains bounded for all time.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $\\\\dot y +2y=x(t)$, $y(0)=3$, and $|x(t)|\\\\le1$, which statement is correct?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Stable: $|y(t)|\\\\le \\frac{7}{2}$ for all $t\\ge0$, so the output stays finite.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Unstable: any nonzero initial condition makes $e^{-2t}y(0)$ unbounded.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Unstable: bounded input cannot be controlled when $|x(t)|$ is small but nonzero.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Stable only if the bound is tightened to $|x(t)|<1$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
