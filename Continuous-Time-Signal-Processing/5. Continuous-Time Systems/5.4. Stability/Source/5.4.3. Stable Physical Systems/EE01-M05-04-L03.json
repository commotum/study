                "block_type": "display-math",
                "text": "",
                "latex": "y(t)=e^{-2t}y(0)+\\\\int_0^t e^{-2(t-\\\\tau)}x(\\\\tau)\\\\,d\\\\tau=3e^{-2t}+\\\\int_0^t e^{-2(t-\\\\tau)}x(\\\\tau)\\\\,d\\\\tau",
