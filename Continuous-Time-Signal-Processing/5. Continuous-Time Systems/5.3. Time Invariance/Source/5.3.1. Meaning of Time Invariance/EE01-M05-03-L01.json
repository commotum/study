                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y_{tts}(t)=\\frac{1}{2}x(t+2T)$ and $y_{sts}(t)=\\frac{1}{2}x(t-2T)$, which uses the wrong direction in STS.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y_{tts}(t)=\\frac{1}{2}x(t-2T)$ and $y_{sts}(t)=\\frac{1}{2}x(t+2T)$, which flips the sign in the TTS path.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y_{tts}(t)=\\frac{1}{2}x(t+2T)$ and $y_{sts}(t)=\\frac{1}{2}x((t+2)T)$, which treats $2T$ as a product inside the argument.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
