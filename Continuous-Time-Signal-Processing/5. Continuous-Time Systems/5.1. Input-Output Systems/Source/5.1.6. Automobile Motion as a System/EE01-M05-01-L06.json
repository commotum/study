            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Using the same system rule as the example, with $a(t)=5$ and $v(0)=1$, write the explicit output signal $v(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [],
