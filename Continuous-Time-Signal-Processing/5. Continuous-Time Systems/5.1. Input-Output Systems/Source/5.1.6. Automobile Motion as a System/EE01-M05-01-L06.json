            "correct_answer": "$v(t)=5t+1$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The rule is $v(t)=\\int_{0}^{t} a(\\tau)\\,d\\tau+v(0)$. With constant acceleration $a(\\tau)=5$, the integral is $\\int_{0}^{t}5\\,d\\tau=5t$, then add $v(0)=1$, so $v(t)=5t+1$.",
                "latex": "",
                "image_slot_id": ""
              }
