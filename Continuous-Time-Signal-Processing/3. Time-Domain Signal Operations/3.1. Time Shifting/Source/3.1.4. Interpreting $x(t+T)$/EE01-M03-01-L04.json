  "tutorial_example_entry": {
    "lesson_index": 4,
    "lesson_title": "Interpreting $x(t+T)$",
    "lesson_core_move": "Interpret $x(t+T)$ for $T > 0 by mapping each original feature time t0 to t0 - T and recognizing the result as a T-unit advance$.",
    "section_count": 4,
    "sections": [
      {
        "lesson_index": 4,
        "lesson_title": "Interpreting $x(t+T)$",
        "section_index": 1,
        "section_title": "Introduction to Interpreting $x(t+T)$",
        "step_type": "tutorial",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "tutorial_content": {
          "blocks": [
            {
              "block_type": "paragraph",
              "text": "Read $x(t+T)$ as a time advance when $T>0$. The plus sign inside the argument means the signal moves left by $T$, not right.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "y(t)=x(t+T)",
              "image_slot_id": ""
            },
            {
              "block_type": "paragraph",
              "text": "Use one labeled feature time $t_0$ as the base case. If that feature appears at $t_0$ in $x(t)$, then it appears at $t_0-T$ in $x(t+T)$.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "t_0 \\mapsto t_0-T",
              "image_slot_id": ""
            },
            {
              "block_type": "paragraph",
              "text": "Only the time labels change. The signal shape, amplitudes, and relative feature pattern stay the same while every landmark shifts left by $T$.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "x(t+T)\\text{ is a }T\\text{-unit advance}",
              "image_slot_id": ""
            },
            {
              "block_type": "paragraph",
              "text": "That sign convention is the one to reuse later: when you see $x(t+T)$ with $T>0$, move each original feature time to $t_0-T$ and read the result as an advance.",
              "latex": "",
              "image_slot_id": ""
            }
          ]
        }
      },
      {
        "lesson_index": 4,
        "lesson_title": "Interpreting $x(t+T)$",
        "section_index": 2,
        "section_title": "Mapping One Feature Time in $x(t+T)$",
        "step_type": "example",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "example_content": {
          "example_prompt": "A signal $x(t)$ has a marked feature at $t_0=6$. Where does that feature appear in $x(t+2)$?",
          "explanation_blocks": [
            {
              "block_type": "paragraph",
              "text": "The cue is the plus sign inside $x(t+T)$. For $T>0$, that sign means an advance: every feature moves left by $T$ while the shape stays the same.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "y(t)=x(t+2)",
              "image_slot_id": ""
            },
            {
              "block_type": "paragraph",
              "text": "Start from the feature time $t_0=6$ and apply the advance rule. The mapping is $t_0\\mapsto t_0-T$.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "t_0 \\mapsto t_0-T",
              "image_slot_id": ""
            },
            {
              "block_type": "paragraph",
              "text": "Substituting $T=2$ gives $6-2=4$, so the feature appears at $t=4$. The signal's value does not change; only the time location does.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "x(t+2)\\text{ is a }2\\text{-unit advance}",
              "image_slot_id": ""
            }
          ]
        }
      },
      {
        "lesson_index": 4,
        "lesson_title": "Interpreting $x(t+T)$",
        "section_index": 3,
        "section_title": "Mapping Multiple Feature Times in $x(t+T)$",
        "step_type": "example",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "example_content": {
          "example_prompt": "A signal $x(t)$ has features at $t=-1$, $t=2$, and $t=5$. Where do those features appear in $x(t+3)$?",
          "explanation_blocks": [
            {
              "block_type": "paragraph",
              "text": "The cue is the plus sign inside $x(t+T)$. For $T>0$, that sign means an advance: every feature moves left by $T$ while the order and spacing stay the same.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "y(t)=x(t+3)",
              "image_slot_id": ""
            },
            {
              "block_type": "paragraph",
              "text": "Start from the three feature times $-1$, $2$, and $5$. Apply the same mapping $t_0\\mapsto t_0-T$ to each time.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "-1 \\mapsto -4,\\quad 2 \\mapsto -1,\\quad 5 \\mapsto 2",
              "image_slot_id": ""
            },
            {
              "block_type": "paragraph",
              "text": "For $T=3$, the mapped times are $-4$, $-1$, and $2$. The spacing is unchanged: the gaps are still $3$ units.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "x(t+3)\\text{ is a }3\\text{-unit advance}",
              "image_slot_id": ""
            }
          ]
        }
      },
      {
        "lesson_index": 4,
        "lesson_title": "Interpreting $x(t+T)$",
        "section_index": 4,
        "section_title": "Mapping the Support Interval of $x(t+T)$",
        "step_type": "example",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "example_content": {
          "example_prompt": "A signal $x(t)$ is nonzero on $1 \\le t < 4$. What is the support of $x(t+2)$?",
          "explanation_blocks": [
            {
              "block_type": "paragraph",
              "text": "The cue is the support interval $1 \\le t < 4$. For $T>0$, $x(t+T)$ advances the whole signal left by $T$; the endpoints move by the same amount, and their open or closed status stays the same.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "y(t)=x(t+2)",
              "image_slot_id": ""
            },
            {
              "block_type": "paragraph",
              "text": "Read the original endpoints as $1$ and $4$. Apply the same shift rule to each endpoint: subtract $2$ from both.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "1 \\mapsto -1,\\quad 4 \\mapsto 2",
              "image_slot_id": ""
            },
            {
              "block_type": "paragraph",
              "text": "The left endpoint stays closed and the right endpoint stays open, so the support of $x(t+2)$ is $-1 \\le t < 2$. The interval keeps the same shape; it just moves left by $2$.",
              "latex": "",
              "image_slot_id": ""
            },
            {
              "block_type": "display-math",
              "text": "",
              "latex": "x(t+2)\\text{ is a }2\\text{-unit advance}",
              "image_slot_id": ""
            }
          ]
        }
      }
    ]
  },
