    "lesson_core_move": "Determine whether a continuous-time signal lacks a convergent Fourier transform by testing the Fourier-transform integral for convergence and interpreting nondecaying or growing behavior as requiring Laplace-domain exponential weighting.",
    "section_count": 4,
    "sections": [
      {
        "lesson_index": 2,
        "lesson_title": "Signals Whose Fourier Transform Does Not Converge",
        "section_index": 2,
        "section_title": "Testing Fourier-Transform Integral Convergence",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $x(t)=e^{-3t}u(t)$, which statement correctly tests whether the Fourier-transform integral $X(j\\omega)=\\int_0^\\infty e^{-3t}e^{-j\\omega t}\\,dt$ converges?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It converges because $\\int_0^\\infty |e^{-3t}e^{-j\\omega t}|\\,dt=\\int_0^\\infty e^{-3t}\\,dt=\\frac{1}{3}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It diverges because the factor $e^{-j\\omega t}$ keeps oscillating as $t\\to\\infty$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It converges only after checking $\\int_{-\\infty}^0 e^{-3t}\\,dt$, since $u(t)$ selects negative time.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It diverges because $|e^{-j\\omega t}|=|\\omega|$, so the envelope is $|\\omega|e^{-3t}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It diverges because every one-sided exponential has a nonzero boundary term at $t=0$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "The Fourier-transform integral converges because the absolute-value integral is finite: $\\int_0^\\infty e^{-3t}\\,dt=\\frac{1}{3}$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The complex kernel has unit magnitude, so the convergence test uses the envelope $e^{-3t}$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\int_0^\\infty |e^{-3t}e^{-j\\omega t}|\\,dt=\\int_0^\\infty e^{-3t}\\,dt=\\frac{1}{3}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "Because this improper integral is finite, the Fourier-transform integral converges.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $x(t)=e^{at}u(t)$ with real $a$, which condition on $a$ makes the Fourier-transform integral $X(j\\omega)=\\int_0^\\infty e^{at}e^{-j\\omega t}\\,dt$ converge?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$a<0$, because then $\\int_0^\\infty e^{at}\\,dt$ is finite.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$a>0$, because a positive exponent cancels the oscillation in $e^{-j\\omega t}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$a=0$, because the kernel $e^{-j\\omega t}$ has magnitude $1$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$a\\le 0$, because zero decay is enough when the phase factor is present.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "All real $a$, because the Fourier-transform kernel always guarantees convergence.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$a<0$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Since $|e^{-j\\omega t}|=1$, absolute convergence is controlled by $\\int_0^\\infty e^{at}\\,dt$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\int_0^\\infty e^{at}\\,dt \\text{ is finite exactly when } a<0",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "For $a=0$ the envelope is constant, and for $a>0$ it grows, so neither case gives a convergent Fourier-transform integral.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
        "lesson_index": 2,
        "lesson_title": "Signals Whose Fourier Transform Does Not Converge",
        "section_index": 3,
        "section_title": "Recognizing Nondecaying Signals That Do Not Converge",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the ordinary Fourier-transform improper integral over $(-\\infty,\\infty)$, classify the signal $x(t)=1$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It does not converge, because the signal does not decay on either tail.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It converges because $x(t)$ is bounded for all $t$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "It converges because $e^{-j\\omega t}$ decays as $|t|$ grows.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
