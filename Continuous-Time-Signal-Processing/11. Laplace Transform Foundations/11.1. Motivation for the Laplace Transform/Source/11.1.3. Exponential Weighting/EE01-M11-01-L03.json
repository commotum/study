              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$|\\omega|<\\sigma$, with value $\\dfrac{2}{\\sigma+j\\omega}$",
                    "latex": "",
