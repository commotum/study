            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Now use the same weighting idea for a left-sided step, $x(t)=u(-t)$. Which condition on $\\sigma$ makes the integral converge, and what is the transformed form?",
                "latex": "",
