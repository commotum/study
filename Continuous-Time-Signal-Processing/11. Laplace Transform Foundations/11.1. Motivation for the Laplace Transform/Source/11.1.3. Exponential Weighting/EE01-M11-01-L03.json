              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\sigma<0$, with value $\\dfrac{2}{\\sigma+j\\omega}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
