      {
        "lesson_index": 4,
        "lesson_title": "The Complex Variable $s=\\sigma+j\\omega$",
        "section_index": 3,
        "section_title": "Combining $e^{-\\sigma t}$ and $e^{-j\\omega t}$ into $e^{-st}$",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Rewrite $e^{-5t}e^{-j2t}$ in $e^{-st}$ form and state $s$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-(5+j2)t}=e^{-st}$ with $s=5+j2$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-5t}e^{-j2t}$, so it is not a single $e^{-st}$ term",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-(5-j2)t}=e^{-st}$ with $s=5-j2$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-(2+j5)t}=e^{-st}$ with $s=2+j5$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-(5+j2)}=e^{-s}$ with $s=5+j2$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$e^{-(5+j2)t}=e^{-st}$ with $s=5+j2$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Combine the exponents because the factors have the same variable $t$: $e^A e^B=e^{A+B}$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "e^{-5t}e^{-j2t}=e^{-5t-j2t}=e^{-(5+j2)t}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "Matching $e^{-(5+j2)t}$ to $e^{-st}$ gives $s=5+j2$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
