        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Factor the denominator and set up the partial-fraction form for $\\frac{3s+8}{s^2-2s-8}$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{3s+8}{s^2-2s-8}=\\frac{A}{s-4}+\\frac{B}{s+2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{3s+8}{s^2-2s-8}=\\frac{A}{s-4}+\\frac{B}{s-4}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{3s+8}{s^2-2s-8}=\\frac{A}{s}+\\frac{B}{s+2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$3s+8=A(s+2)+B(s-4)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{3s+8}{s^2-2s-8}=\\frac{3}{s-4}+\\frac{1}{s+2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\frac{3s+8}{s^2-2s-8}=\\frac{A}{s-4}+\\frac{B}{s+2}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Factor first: $s^2-2s-8=(s-4)(s+2)$, so each distinct linear factor gets its own constant numerator term in the template.",
                "latex": "",
                "image_slot_id": ""
              },
              {
