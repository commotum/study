            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For which values of $b$ does $x(t)=e^{-bt}u(t)$ have finite energy, and what is the energy when it converges?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Finite only when $b>0$; then $E=\\frac{1}{2b}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Finite only when $b\\ge 0$; then $E=\\frac{1}{b}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Finite only when $b<0$; then $E=\\frac{1}{2b}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Infinite for every $b$ because $u(t)$ makes the signal last forever.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Finite for every $b$; then $E=\\frac{1}{b}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "Finite only when $b>0$; then $E=\\frac{1}{2b}$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Because $u(t)$ restricts the signal to $t\\ge 0$, the energy is $E=\\int_0^\\infty |e^{-bt}|^2\\,dt=\\int_0^\\infty e^{-2bt}\\,dt$. That improper integral converges only when $b>0$, and then $E=\\frac{1}{2b}$. If $b\\le 0$, the integral does not converge.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
