      {
        "lesson_index": 6,
        "lesson_title": "Time-Domain vs. Frequency-Domain Views",
        "section_index": 3,
        "section_title": "Reading Harmonic Frequencies Across Views",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "A periodic signal is given by $x(t)=2+5\\cos(\\omega_0 t)-3\\sin(2\\omega_0 t)+\\sin(4\\omega_0 t)$. Which harmonic frequencies appear in its frequency-domain description?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\{0, \\omega_0, 2\\omega_0, 4\\omega_0\\}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\{0, \\omega_0, 3\\omega_0, 4\\omega_0\\}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\{0, \\omega_0, 2\\omega_0, 5\\omega_0\\}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\{0, \\omega_0, 4\\omega_0\\}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\{0, \\omega_0, 2\\omega_0, 3\\omega_0, 4\\omega_0\\}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\{0, \\omega_0, 2\\omega_0, 4\\omega_0\\}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The frequencies come from the arguments of the sinusoidal terms, not from the coefficient sizes. The constant term gives the DC component at $0$, and the terms at $\\omega_0$, $2\\omega_0$, and $4\\omega_0$ give those three harmonic lines.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "A frequency-domain description has the only nonzero coefficients $a_0=1$, $a_1=-4$, $b_1=2$, and $a_3=5$. Which harmonic frequencies are present in the matching waveform?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\{0, \\omega_0, 3\\omega_0\\}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
