      {
        "lesson_index": 4,
        "lesson_title": "Meaning of Fourier Coefficients",
        "section_index": 3,
        "section_title": "Interpreting Signed Cosine Weights from $a_k$",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "A signal has $a_1=-5$ and $a_2=1$ in its trigonometric Fourier series. Which statement correctly interprets these cosine coefficients?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The $\\omega_0$ cosine term is inverted with strength $5$, and the $2\\omega_0$ cosine term is positive with strength $1$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The $\\omega_0$ sine term is inverted with strength $5$, and the $2\\omega_0$ sine term is positive with strength $1$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The coefficients give the frequencies $5\\omega_0$ and $1\\omega_0$, not the weights.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Because $a_1$ is negative, there is no cosine term at $\\omega_0$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Because $a_2$ is positive, the $2\\omega_0$ cosine term is absent.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "The $\\omega_0$ cosine term is inverted with strength $5$, and the $2\\omega_0$ cosine term is positive with strength $1$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "$a_k$ is the signed weight on the cosine harmonic at frequency $k\\omega_0$. So $a_1=-5$ means an inverted cosine contribution of strength $5$ at $\\omega_0$, and $a_2=1$ means a positive cosine contribution of strength $1$ at $2\\omega_0$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "A signal has $a_2=0$ and $a_4=-3$ in its trigonometric Fourier series. Which statement correctly interprets the cosine harmonics?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "There is no cosine harmonic at $2\\omega_0$, and the $4\\omega_0$ cosine term is inverted with magnitude $3$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "There is a cosine harmonic at $2\\omega_0$ with amplitude $0$, and the $4\\omega_0$ cosine term is positive with magnitude $3$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The $2\\omega_0$ term is a sine harmonic, and the $4\\omega_0$ term is a DC offset.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The $4\\omega_0$ harmonic is missing because the coefficient is negative.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The sign of $a_4$ only changes phase, not the cosine contribution.",
                    "latex": "",
                    "image_slot_id": ""
