    "section_count": 4,
    "sections": [
      {
        "lesson_index": 6,
        "lesson_title": "Complex-Valued Fourier Coefficients",
        "section_index": 2,
        "section_title": "Evaluating One Complex Coefficient Integral",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
