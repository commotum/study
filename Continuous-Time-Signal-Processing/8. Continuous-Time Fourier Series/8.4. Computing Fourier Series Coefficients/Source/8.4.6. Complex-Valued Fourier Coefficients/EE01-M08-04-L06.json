            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For a real periodic signal with $c_4=2-j$ and $c_{-4}=2+j$, which statement best explains what these harmonic weights mean in the reconstruction?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "They are two unrelated amplitudes, one for the positive harmonic and one for the negative harmonic.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Only $c_4$ matters, because the negative-index coefficient can be ignored for real signals.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "They are conjugate partners that together encode one real $k=4$ harmonic; the positive coefficient carries the amplitude-and-phase weight.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "They are the instantaneous value of the signal at $t=4$.",
