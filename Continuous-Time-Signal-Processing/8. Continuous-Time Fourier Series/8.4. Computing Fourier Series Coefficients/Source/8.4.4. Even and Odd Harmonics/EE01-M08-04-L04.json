                "block_type": "display-math",
                "text": "",
                "latex": "\\begin{aligned}k = 2m &\\Rightarrow (-1)^k = 1 \\Rightarrow 1 + (-1)^k = 2 \\\\ k = 2m + 1 &\\Rightarrow (-1)^k = -1 \\Rightarrow 1 + (-1)^k = 0\\end{aligned}",
                "image_slot_id": ""
