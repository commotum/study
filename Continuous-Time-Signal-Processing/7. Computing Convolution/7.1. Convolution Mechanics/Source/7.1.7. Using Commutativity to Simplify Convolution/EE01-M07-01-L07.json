      {
        "lesson_index": 7,
        "lesson_title": "Using Commutativity to Simplify Convolution",
        "section_index": 3,
        "section_title": "Choosing the Easier Shifted Signal",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $p(t)=e^{-2t}u(t)$ and $q(t)=u(t-1)-u(t-4)$, which convolution form makes the overlap setup simpler?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Use $\\int p(\\tau)q(t-\\tau)\\,d\\tau$, because the one-sided exponential should stay fixed and the finite pulse should move with $t$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Use $\\int q(\\tau)p(t-\\tau)\\,d\\tau$, because swapping is the better choice for every convolution.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Use $\\int q(\\tau)p(t-\\tau)\\,d\\tau$, because $q(\\tau)$ keeps the finite support $1\\le \\tau\\le 4$ fixed and $p(t-\\tau)$ is the shifted one-sided factor.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Use $\\int p(\\tau)q(t-\\tau)\\,d\\tau$, because the exponential formula determines which factor should be fixed.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Use either form with no preference, because commutativity makes the support setup identical.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "C"
            ],
            "correct_answer": "Use $\\int q(\\tau)p(t-\\tau)\\,d\\tau$, because the finite support of $q$ stays fixed in $\\tau$ while the one-sided factor $p$ is shifted.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "$p(t)=e^{-2t}u(t)$ is one-sided, while $q(t)=u(t-1)-u(t-4)$ has finite support from $1$ to $4$. The simpler setup keeps that finite interval fixed as $q(\\tau)$ and shifts the one-sided factor as $p(t-\\tau)$.",
                "latex": "",
