          {
            "section_type": "content",
            "normalized_html": "<p>Suppose that we have a cube whose edges are <span class=\"math\">[MATH: 2\\,\\textrm{cm}]</span> in length, like the one shown below. </p>",
            "readable_text": "Suppose that we have a cube whose edges are [MATH: 2\\,\\textrm{cm}] in length, like the one shown below.",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
          },
          {
            "section_type": "graphic",
            "normalized_html": "<p><img src=\"/graphics/d04832ca9d8be3328d8c1b27f8076fa5\"></p>",
