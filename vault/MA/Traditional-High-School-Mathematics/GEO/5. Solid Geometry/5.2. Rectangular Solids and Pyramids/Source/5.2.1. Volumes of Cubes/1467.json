        "sections": [
          {
            "section_type": "example_question",
            "normalized_html": "<p>Six identical plastic cubic containers have a combined volume of <span class=\"math\">[MATH: 48 \\: \\textrm{ft}^3.]</span> Find the side length of a single container.  </p>",
            "readable_text": "Six identical plastic cubic containers have a combined volume of [MATH: 48 \\: \\textrm{ft}^3.] Find the side length of a single container.",
