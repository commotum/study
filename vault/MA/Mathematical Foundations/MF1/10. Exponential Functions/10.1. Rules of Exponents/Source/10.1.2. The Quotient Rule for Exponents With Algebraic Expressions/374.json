            "normalized_html": "<p>Simplify the  expression <span class=\"math\">[MATH: \\dfrac {p^7} {p^2}  \\cdot p^3 .]</span></p>",
            "readable_text": "Simplify the expression [MATH: \\dfrac {p^7} {p^2} \\cdot p^3 .]",
            "images": [],
