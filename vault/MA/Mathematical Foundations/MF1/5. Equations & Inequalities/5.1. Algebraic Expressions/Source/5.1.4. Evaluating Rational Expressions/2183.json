          {
            "section_type": "example_question",
            "normalized_html": "<p>Evaluate <span class=\"math\">[MATH: \\dfrac{x-2}{x+1}]</span> for <span class=\"math\">[MATH: x=5.]</span></p>",
            "readable_text": "Evaluate [MATH: \\dfrac{x-2}{x+1}] for [MATH: x=5.]",
