              }
            ],
            "free_entry_blanks": [],
            "select_lists": []
          },
          {
            "section_type": "content",
            "normalized_html": "<p>Therefore,</p>",
            "readable_text": "Therefore,",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
          },
          {
            "section_type": "content",
            "normalized_html": "<p><span class=\"math\">[MATH: 4(a + 2b + 3)|=; 4 \u22c5 a + 4 \u22c5 2b + 4 \u22c5 3|=; (4a) + (8b) + (12)|=; 4a + 8b + 12]</span></p>",
            "readable_text": "[MATH: 4(a + 2b + 3)|=; 4 \u22c5 a + 4 \u22c5 2b + 4 \u22c5 3|=; (4a) + (8b) + (12)|=; 4a + 8b + 12]",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
          },
          {
            "section_type": "content",
            "normalized_html": "<p>The distributive law also applies when the multiplication occurs on the right of the parentheses. Let&#x27;s see an example.</p>",
            "readable_text": "The distributive law also applies when the multiplication occurs on the right of the parentheses. Let's see an example.",
            "images": [],
            "free_entry_blanks": [],
