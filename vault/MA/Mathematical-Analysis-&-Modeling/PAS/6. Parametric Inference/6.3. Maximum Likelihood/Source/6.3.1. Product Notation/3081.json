        "sections": [
          {
            "section_type": "example_question",
            "normalized_html": "<p>Express the following product using product notation:</p><p><span class=\"math\">[MATH: (2 - 3^2) \\cdot (2 - 4^2) \\cdot (2 - 5^2) \\cdot \\: \\ldots \\: \\cdot (2 - 12^2)]</span></p>",
            "readable_text": "Express the following product using product notation:\n\n[MATH: (2 - 3^2) \\cdot (2 - 4^2) \\cdot (2 - 5^2) \\cdot \\: \\ldots \\: \\cdot (2 - 12^2)]",
