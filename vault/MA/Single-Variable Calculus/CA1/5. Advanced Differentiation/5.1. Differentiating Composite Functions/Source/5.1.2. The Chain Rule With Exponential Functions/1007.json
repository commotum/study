            "section_type": "example_question",
            "normalized_html": "<p>Given that <span class=\"math\">[MATH: y= 3\\cdot 2^{1 - x},]</span> find <span class=\"math\">[MATH: \\dfrac{\\textrm d y}{\\textrm d x}.]</span></p>",
