        "sections": [
          {
            "section_type": "example_question",
            "normalized_html": "<p>Calculate <span class=\"math\">[MATH: \\displaystyle \\int \\left( 5(\\sqrt{x})^{3} - 4 x^2 + 5\\right) \\,\\textrm d x.]</span></p>",
            "readable_text": "Calculate [MATH: \\displaystyle \\int \\left( 5(\\sqrt{x})^{3} - 4 x^2 + 5\\right) \\,\\textrm d x.]",
            "images": [],
            "free_entry_blanks": [],
