          },
          {
            "section_type": "content",
            "normalized_html": "<p><span class=\"math\">[MATH: 2x + 6|&lt; 12; 2x + 6 \u2212 6|&lt; 12 \u2212 6; 2x + 0|&lt; 6; 2x|&lt; 6]</span></p>",
            "readable_text": "[MATH: 2x + 6|< 12; 2x + 6 \u2212 6|< 12 \u2212 6; 2x + 0|< 6; 2x|< 6]",
