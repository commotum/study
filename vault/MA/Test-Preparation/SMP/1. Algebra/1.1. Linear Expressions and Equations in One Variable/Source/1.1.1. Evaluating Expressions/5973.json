        "sections": [
          {
            "section_type": "example_question",
            "normalized_html": "<p>If <span class=\"math\">[MATH: 7x = 63,]</span> what is the value of <span class=\"math\">[MATH: 7x + 6?]</span></p>",
            "readable_text": "If [MATH: 7x = 63,] what is the value of [MATH: 7x + 6?]",
