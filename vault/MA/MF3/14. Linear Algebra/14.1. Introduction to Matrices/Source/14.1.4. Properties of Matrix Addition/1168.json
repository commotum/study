          {
            "section_type": "content",
            "normalized_html": "<p>If we want to add (or subtract) three or more matrices, all operations should be done elementwise. For example, suppose</p>",
            "readable_text": "If we want to add (or subtract) three or more matrices, all operations should be done elementwise. For example, suppose",
            "images": [],
