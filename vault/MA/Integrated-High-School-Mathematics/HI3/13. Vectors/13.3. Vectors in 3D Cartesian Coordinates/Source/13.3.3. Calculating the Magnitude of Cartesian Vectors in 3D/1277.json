        "title": "Calculating the Magnitude of a Vector Given the Coordinates of its Endpoints",
        "key_prerequisites": [
          {
            "topic_id": "175",
            "name": "Addition and Scalar Multiplication of Cartesian Vectors in 3D",
            "href": "/topics/175",
