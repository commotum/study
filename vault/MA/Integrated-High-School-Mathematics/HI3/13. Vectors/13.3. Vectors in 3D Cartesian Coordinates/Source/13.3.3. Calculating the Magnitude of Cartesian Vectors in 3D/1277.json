        "sections": [
          {
            "section_type": "example_question",
            "normalized_html": "<p>Let <span class=\"math\">[MATH: \\mathbf{a}=\\langle 2, -3, -7 \\rangle]</span>. Find <span class=\"math\">[MATH: |\\mathbf{a}|]</span>.</p>",
            "readable_text": "Let [MATH: \\mathbf{a}=\\langle 2, -3, -7 \\rangle]. Find [MATH: |\\mathbf{a}|].",
