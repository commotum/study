          {
            "section_type": "content",
            "normalized_html": "<p>Consider the vector <span class=\"math\">[MATH: \\mathbf{a}=\\langle 2,-1,3 \\rangle,]</span> shown below.</p>",
            "readable_text": "Consider the vector [MATH: \\mathbf{a}=\\langle 2,-1,3 \\rangle,] shown below.",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
          },
          {
            "section_type": "graphic",
            "normalized_html": "<p><img src=\"/graphics/3309f41e2b21210b444cb4192ea7233c\"></p>",
            "readable_text": "[IMG: /graphics/3309f41e2b21210b444cb4192ea7233c]",
