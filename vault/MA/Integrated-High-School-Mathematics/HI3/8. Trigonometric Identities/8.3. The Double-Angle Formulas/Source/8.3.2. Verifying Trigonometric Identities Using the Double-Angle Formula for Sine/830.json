          {
            "section_type": "example_question",
            "normalized_html": "<p>Simplify the expression <span class=\"math\">[MATH: 2\\tan x \\csc 2x.]</span> </p>",
            "readable_text": "Simplify the expression [MATH: 2\\tan x \\csc 2x.]",
            "images": [],
