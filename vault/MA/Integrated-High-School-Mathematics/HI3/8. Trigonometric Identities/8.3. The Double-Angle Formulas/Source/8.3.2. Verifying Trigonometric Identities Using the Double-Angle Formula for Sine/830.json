          {
            "section_type": "example_question",
            "normalized_html": "<p>Simplify the expression <span class=\"math\">[MATH: \\dfrac{\\sin^2{x}}{\\sin{2x}}.]</span></p>",
            "readable_text": "Simplify the expression [MATH: \\dfrac{\\sin^2{x}}{\\sin{2x}}.]",
