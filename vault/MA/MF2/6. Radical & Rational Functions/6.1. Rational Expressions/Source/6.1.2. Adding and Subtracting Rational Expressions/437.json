          {
            "section_type": "example_question",
            "normalized_html": "<p>Simplify <span class=\"math\">[MATH: \\dfrac{y}{x(1+y)} + \\dfrac{y}{1+y}.]</span></p>",
            "readable_text": "Simplify [MATH: \\dfrac{y}{x(1+y)} + \\dfrac{y}{1+y}.]",
            "images": [],
