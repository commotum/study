          {
            "section_type": "example_question",
            "normalized_html": "<p>Simplify <span class=\"math\">[MATH: \\dfrac{2+a}{2a} + \\dfrac{3+2a}{2a}.]</span></p>",
            "readable_text": "Simplify [MATH: \\dfrac{2+a}{2a} + \\dfrac{3+2a}{2a}.]",
