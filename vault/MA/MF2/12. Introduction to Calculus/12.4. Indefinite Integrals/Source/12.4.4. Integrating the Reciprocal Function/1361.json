            "normalized_html": "<p>What is the antiderivative of <span class=\"math\">[MATH: \\dfrac {3+2x} {x} ?]</span></p>",
            "readable_text": "What is the antiderivative of [MATH: \\dfrac {3+2x} {x} ?]",
            "images": [],
