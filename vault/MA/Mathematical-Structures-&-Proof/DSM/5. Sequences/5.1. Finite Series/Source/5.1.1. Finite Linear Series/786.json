            "normalized_html": "<p>Calculate <span class=\"math\">[MATH: \\displaystyle\\sum_{n=1}^{200} (3n+2).]</span></p>",
            "readable_text": "Calculate [MATH: \\displaystyle\\sum_{n=1}^{200} (3n+2).]",
