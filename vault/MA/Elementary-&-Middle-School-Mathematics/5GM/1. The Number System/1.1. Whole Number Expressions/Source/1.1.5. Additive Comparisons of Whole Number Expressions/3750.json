            "readable_text": "[MATH: [(9-5) \\div 2]]",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
          },
          {
            "section_type": "content",
            "normalized_html": "<p>Then, we add <span class=\"math\">[MATH: 6]</span>:</p>",
            "readable_text": "Then, we add [MATH: 6]:",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
          },
          {
            "section_type": "content",
            "normalized_html": "<p><span class=\"math\">[MATH: 6+[(9-5) \\div 2]]</span></p>",
            "readable_text": "[MATH: 6+[(9-5) \\div 2]]",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
