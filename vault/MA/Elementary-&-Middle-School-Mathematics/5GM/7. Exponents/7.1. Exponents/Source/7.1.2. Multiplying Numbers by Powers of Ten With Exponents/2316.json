        "sections": [
          {
            "section_type": "content",
            "normalized_html": "<p>When a power of ten is written in exponent form, we can express it as a <span class=\"math\">[MATH: 1]</span> followed by a block of zeros. The number of zeros in the block should equal the exponent. For example, </p>",
            "readable_text": "When a power of ten is written in exponent form, we can express it as a [MATH: 1] followed by a block of zeros. The number of zeros in the block should equal the exponent. For example,",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
          },
          {
