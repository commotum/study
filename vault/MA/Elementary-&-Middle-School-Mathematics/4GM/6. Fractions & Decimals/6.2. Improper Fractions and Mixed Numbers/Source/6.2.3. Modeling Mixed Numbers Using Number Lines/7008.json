          {
            "section_type": "content",
            "normalized_html": "<p>We can represent mixed numbers with number lines.</p>",
            "readable_text": "We can represent mixed numbers with number lines.",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
          },
          {
            "section_type": "content",
            "normalized_html": "<p>For example, let&#x27;s write the number shown on the number line below as a mixed number.</p>",
            "readable_text": "For example, let's write the number shown on the number line below as a mixed number.",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
          },
          {
            "section_type": "graphic",
            "normalized_html": "<p><img src=\"/graphics/fb88c92d4c5779868600d0189699d514\"></p>",
            "readable_text": "[IMG: /graphics/fb88c92d4c5779868600d0189699d514]",
