            "select_lists": []
          },
          {
            "section_type": "content",
            "normalized_html": "<p>Therefore, the mixed number is <span class=\"math\">[MATH: {\\color{red}1}{\\color{blue}\\dfrac{2}{3}}.]</span></p>",
            "readable_text": "Therefore, the mixed number is [MATH: {\\color{red}1}{\\color{blue}\\dfrac{2}{3}}.]",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
          }
        ],
