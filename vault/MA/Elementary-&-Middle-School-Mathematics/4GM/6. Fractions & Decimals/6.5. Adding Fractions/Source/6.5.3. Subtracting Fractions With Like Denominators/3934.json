            "normalized_html": "<p>Find the value of <span class=\"math\">[MATH: \\dfrac{23}{9} - \\dfrac{8}{9}.]</span></p>",
            "readable_text": "Find the value of [MATH: \\dfrac{23}{9} - \\dfrac{8}{9}.]",
