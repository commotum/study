        "sections": [
          {
            "section_type": "example_question",
            "normalized_html": "<p>Compute the value of <span class=\"math\">[MATH: 3,200 \\div 4.]</span></p>",
            "readable_text": "Compute the value of [MATH: 3,200 \\div 4.]",
            "images": [],
            "free_entry_blanks": [],
