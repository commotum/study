            "section_type": "content",
            "normalized_html": "<p>We can use place value strategies to multiply any whole number by <span class=\"math\">[MATH: 10.]</span></p>",
            "readable_text": "We can use place value strategies to multiply any whole number by [MATH: 10.]",
            "images": [],
