            "select_lists": []
          },
          {
            "section_type": "content",
            "normalized_html": "<p>For example, let&#x27;s use our understanding of place value to solve the following multiplication problem:</p>",
            "readable_text": "For example, let's use our understanding of place value to solve the following multiplication problem:",
            "images": [],
            "free_entry_blanks": [],
