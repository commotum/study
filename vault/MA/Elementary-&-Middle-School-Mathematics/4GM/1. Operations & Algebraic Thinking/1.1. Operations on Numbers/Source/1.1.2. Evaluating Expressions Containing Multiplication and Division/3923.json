          {
            "section_type": "example_question",
            "normalized_html": "<p>What is <span class=\"math\">[MATH: 36\\div 6 \\times 10?]</span></p>",
            "readable_text": "What is [MATH: 36\\div 6 \\times 10?]",
            "images": [],
            "free_entry_blanks": [],
            "select_lists": []
          },
          {
            "section_type": "content",
            "normalized_html": "<p>EXPLANATION</p>",
