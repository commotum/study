          {
            "section_type": "example_question",
            "normalized_html": "<p>Simplify the expression <span class=\"math\">[MATH: -(2x-1.3).]</span></p>",
            "readable_text": "Simplify the expression [MATH: -(2x-1.3).]",
            "images": [],
