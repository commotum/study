        "sections": [
          {
            "section_type": "example_question",
            "normalized_html": "<p>Find the value of <span class=\"math\">[MATH: 2 + \\left(-4\\right)^{-2} \\div \\left( 1.5 + \\dfrac{2}{15} \\right)^0.]</span></p>",
            "readable_text": "Find the value of [MATH: 2 + \\left(-4\\right)^{-2} \\div \\left( 1.5 + \\dfrac{2}{15} \\right)^0.]",
