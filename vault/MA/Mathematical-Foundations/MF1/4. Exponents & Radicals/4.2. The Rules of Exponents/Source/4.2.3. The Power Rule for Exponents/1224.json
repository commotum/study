          {
            "section_type": "example_question",
            "normalized_html": "<p>Express <span class=\"math\">[MATH: \\left(2\\cdot 4^3\\right)^2]</span> as a base raised to a single exponent.</p>",
            "readable_text": "Express [MATH: \\left(2\\cdot 4^3\\right)^2] as a base raised to a single exponent.",
