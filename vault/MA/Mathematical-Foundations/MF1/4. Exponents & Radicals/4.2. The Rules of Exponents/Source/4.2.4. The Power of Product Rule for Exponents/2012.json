          {
            "section_type": "example_question",
            "normalized_html": "<p>Express <span class=\"math\">[MATH: (3\\times 2)^2]</span> as the product of two powers.</p>",
            "readable_text": "Express [MATH: (3\\times 2)^2] as the product of two powers.",
