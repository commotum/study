          {
            "section_type": "example_question",
            "normalized_html": "<p>Express <span class=\"math\">[MATH: \\left(\\dfrac{3}{4}\\right)^2]</span> as the quotient of two powers.</p>",
            "readable_text": "Express [MATH: \\left(\\dfrac{3}{4}\\right)^2] as the quotient of two powers.",
