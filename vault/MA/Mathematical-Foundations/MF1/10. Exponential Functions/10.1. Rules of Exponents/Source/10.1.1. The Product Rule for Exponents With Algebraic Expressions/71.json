          {
            "section_type": "example_question",
            "normalized_html": "<p>Find <span class=\"math\">[MATH: n]</span> such that <span class=\"math\">[MATH: x^2\\cdot x^3 \\cdot x^4 = x^n]</span> is correct. </p>",
