                    "text": "Yes, $4$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Yes, $6$.",
                    "latex": "",
