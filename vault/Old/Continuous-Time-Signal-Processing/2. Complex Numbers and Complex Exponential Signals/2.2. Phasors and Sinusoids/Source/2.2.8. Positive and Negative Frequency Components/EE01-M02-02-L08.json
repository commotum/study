                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{7}{2}e^{-j\\pi/5}e^{j2t}+\\frac{7}{2}e^{j\\pi/5}e^{-j2t}$",
