        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Which expression is another way to write the same unit impulse at the origin as $\\delta(t)$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\delta(t-0)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\delta(t-1)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$2\\delta(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$u(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$r(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\delta(t-0)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "A zero shift does not move the support. $\\delta(t-0)$ is just $\\delta(t)$ with the offset written explicitly.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\delta(t)=\\delta(t-0)",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "The other choices either move the support away from $t=0$ or replace the point impulse with a step or ramp, and $2\\delta(t)$ changes the impulse weight instead of preserving the same unit impulse.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Which expression still keeps the impulse centered at the origin when the zero shift is written with a plus sign?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\delta(t+0)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\delta(t+1)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\delta(t-1)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$u(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$r(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\delta(t+0)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The plus sign still means zero shift because $+0=0$, so the support remains at $t=0$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\delta(t+0)=\\delta(t)",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "The shifted impulse choices move the support away from the origin, while the step and ramp choices are not point impulses at all.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
