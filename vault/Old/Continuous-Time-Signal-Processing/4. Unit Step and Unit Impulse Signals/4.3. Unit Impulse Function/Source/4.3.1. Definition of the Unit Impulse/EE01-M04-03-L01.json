                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "For fixed $t\\ne1$, $y_\\epsilon(t)\\to0$, and the integrated area goes to $0$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The pulse keeps a finite width around $t=1$, and the integrated area stays $1$.",
