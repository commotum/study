            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Simplify $x(t)=\\frac12\\delta(t)+\\delta(t)+\\delta(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac52\\delta(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac52$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac52\\delta(t-1)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac12\\delta(2t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac32\\delta(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\frac52\\delta(t)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "All three terms are co-located at $t=0$, so combine only the coefficients: $\\frac12+1+1=\\frac52$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "x(t)=\\frac12\\delta(t)+\\delta(t)+\\delta(t)=\\frac52\\delta(t)",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "The support stays at the origin; only the impulse weight changes.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Which expression is equivalent to $x(t)=\\frac32\\delta(t)-\\delta(t)-\\delta(t)$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$-\\frac12\\delta(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac12\\delta(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$-\\frac12$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$-\\frac12\\delta(t+1)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$-\\frac12\\delta(2t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$-\\frac12\\delta(t)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The three impulses are again at the same support point, so combine coefficients only: $\\frac32-1-1=-\\frac12$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "x(t)=\\frac32\\delta(t)-\\delta(t)-\\delta(t)=-\\frac12\\delta(t)",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "A negative coefficient means a negative impulse weight, not a shift and not an ordinary amplitude.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
