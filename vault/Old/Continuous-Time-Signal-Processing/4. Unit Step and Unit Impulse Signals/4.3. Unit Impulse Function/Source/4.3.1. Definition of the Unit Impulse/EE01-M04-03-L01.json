                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The area is $-3$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The area is $-3\\delta(0)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The area is $0$ because a negative coefficient makes the impulse disappear.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The area is $3$ because only the magnitude of the coefficient matters.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The area is $1$ because every unit impulse has unit area.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "The area is $-3$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The coefficient is the area weight, so the sign is preserved when you integrate the impulse.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\int_{-\\infty}^{\\infty}-3\\delta(t)\\,dt = -3\\int_{-\\infty}^{\\infty}\\delta(t)\\,dt = -3",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "So the correct choice is A.",
