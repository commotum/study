            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $x(t)=2\\delta(t)$, which statement correctly gives $\\int_{-\\infty}^{\\infty}x(t)\\,dt$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The area is $2$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The area is $2\\delta(0)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The area is $0$ because the impulse has zero width.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The area is $2$ because the impulse is treated like a rectangle of height $2$ and width $1$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
