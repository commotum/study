            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $x(t)=-3\\delta(t)$, which statement correctly gives $\\int_{-\\infty}^{\\infty}x(t)\\,dt$?",
