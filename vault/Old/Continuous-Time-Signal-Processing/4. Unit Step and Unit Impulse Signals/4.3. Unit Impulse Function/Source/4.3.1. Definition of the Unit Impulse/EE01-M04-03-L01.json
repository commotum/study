                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The pulse spreads across all $t$, and the integrated area stays $1$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "For fixed $t\\ne1$, $y_\\epsilon(t)\\to0$, and the integrated area stays $1$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Shifting the center from $0$ to $1$ changes the location, not the zero-width logic. For fixed $t\\ne1$, the shrinking interval around $1$ eventually excludes $t$, so the pointwise value goes to $0$ away from $t=1$. The area is still $(1/\\epsilon)(\\epsilon)=1$.",
                "latex": "",
                "image_slot_id": ""
