                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "The area is $2$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Use the unit-area rule for the impulse: scaling by a constant scales the integral by the same constant.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\int_{-\\infty}^{\\infty}2\\delta(t)\\,dt = 2\\int_{-\\infty}^{\\infty}\\delta(t)\\,dt = 2",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "So the correct choice is A.",
                "latex": "",
                "image_slot_id": ""
              }
