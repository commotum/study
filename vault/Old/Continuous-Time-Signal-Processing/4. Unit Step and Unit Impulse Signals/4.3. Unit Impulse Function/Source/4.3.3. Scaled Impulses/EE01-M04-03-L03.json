        "section_index": 4,
        "section_title": "Interpreting Negative and Fractional Impulse Weights",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $y(t)=2\\delta(t)+\\frac{1}{2}\\delta(t-1)-\\delta(t+3)$, which term has negative area and what is the net signed area?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The third term has negative area, and the net signed area is $\\frac{3}{2}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The third term has negative area, and the net signed area is $\\frac{7}{2}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The term at $t=3$ has negative area, and the net signed area is $\\frac{3}{2}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "All three terms have positive area, and the net signed area is $\\frac{3}{2}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "The third term has negative area, and the net signed area is $1$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "The third term has negative area, and the net signed area is $\\frac{3}{2}$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Read the coefficient in front of each impulse as its area weight. The third term has a negative coefficient, so it has negative area; the shift $t+3$ only places that area at $t=-3$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
