                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{-3t}u(t) \\leftrightarrow \\frac{1}{3+j\\omega}$",
                    "latex": "",
