                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$e^{3t}u(t) \\leftrightarrow \\frac{1}{3-j\\omega}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$e^{3t}u(-t) \\leftrightarrow \\frac{1}{3-j\\omega}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Time reversal flips both the time variable and the frequency variable. If $x(t) \\leftrightarrow X(j\\omega)$, then $x(-t) \\leftrightarrow X(-j\\omega)$.",
                "latex": "",
                "image_slot_id": ""
              },
