            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given the known pair $x(t)=e^{-3t}u(t) \\leftrightarrow X(j\\omega)=\\frac{1}{3+j\\omega}$, which pair is $x(-t)$?",
