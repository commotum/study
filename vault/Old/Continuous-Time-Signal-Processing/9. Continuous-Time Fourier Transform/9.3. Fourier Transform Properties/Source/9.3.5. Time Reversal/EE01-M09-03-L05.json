                "block_type": "display-math",
                "text": "",
                "latex": "x(-t)=e^{3t}u(-t) \\leftrightarrow X(-j\\omega)=\\frac{1}{3-j\\omega}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "That matches choice A. The other choices either leave the spectrum unchanged or fail to reverse the signal correctly.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
