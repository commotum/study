            "correct_answer": "$\\frac{4-2j\\omega}{1+5j\\omega}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Negate $\\omega$ everywhere in the explicit spectrum. That flips the sign on every $j\\omega$ term, but it does not change the constants.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "X(-j\\omega)=\\frac{4-2j\\omega}{1+5j\\omega}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "So the time-reversed spectrum is $\\frac{4-2j\\omega}{1+5j\\omega}$. The correct move is sign replacement, not leaving the spectrum unchanged or flipping only one part.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
