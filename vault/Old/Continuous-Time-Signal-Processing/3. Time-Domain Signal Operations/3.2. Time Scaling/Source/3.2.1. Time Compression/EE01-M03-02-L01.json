            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "It is compressed toward $t=0$, and each time feature moves to one-fifth of its original time with unchanged amplitude.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Because $5>1$, the factor inside $x(5t)$ makes time run faster. The signal is compressed toward $t=0$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "t=t_0/5",
