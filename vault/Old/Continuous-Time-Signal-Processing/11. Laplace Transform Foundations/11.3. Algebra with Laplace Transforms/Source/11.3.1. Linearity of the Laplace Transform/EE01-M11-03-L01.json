              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{1}{2(s+4)}$",
                    "latex": "",
                    "image_slot_id": ""
