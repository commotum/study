                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{1}{s+4}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{1}{2(s-4)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{1}{2(s+4)}u(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{1}{4s+4}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\frac{1}{2(s+4)}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Match to the causal exponential template $\\mathcal{L}_+\\{e^{-4t}u(t)\\}=\\frac{1}{s+4}$. Pull the scalar $\\frac{1}{2}$ outside: $\\mathcal{L}_+\\{\\frac{1}{2}e^{-4t}u(t)\\}=\\frac{1}{2}\\mathcal{L}_+\\{e^{-4t}u(t)\\}.$",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\mathcal{L}_+\\left\\{\\frac{1}{2}e^{-4t}u(t)\\right\\}=\\frac{1}{2}\\cdot\\frac{1}{s+4}=\\frac{1}{2(s+4)}",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Find the one-sided Laplace transform of $x(t)=\\frac{3}{4}e^{2t}u(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{3}{4(s-2)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{3}{4(s+2)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{3}{4(s-2)}u(t)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{3}{(s-2)/4}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$\\frac{1}{s-2}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$\\frac{3}{4(s-2)}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Use the same causal exponential rule with growth: $\\mathcal{L}_+\\{e^{2t}u(t)\\}=\\frac{1}{s-2}$. Since the coefficient is $\\frac{3}{4}$, move it outside by linearity and multiply the numerator only.",
                "latex": "",
