                "block_type": "display-math",
                "text": "",
                "latex": "\\mathcal{L}_+\\left\\{\\frac{3}{4}e^{2t}u(t)\\right\\}=\\frac{3}{4}\\cdot\\frac{1}{s-2}=\\frac{3}{4(s-2)}",
                "image_slot_id": ""
              }
            ]
          }
        ]
