      {
        "lesson_index": 2,
        "lesson_title": "BIBO Stability",
        "section_index": 4,
        "section_title": "Verifying BIBO Stability for Shifted-Input System Rules",
        "step_type": "example",
        "question_type": "select-list",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "select-list",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the system $y(t)=2x(t-2)-x(t+3)$, assume $x(t)$ is bounded so that $|x(t)| \\le M$ for all $t$. Which statement about BIBO stability is correct?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "BIBO stable, because the same bounded-input magnitude $M$ applies to both shifted copies and $|y(t)| \\le 3M$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Not BIBO stable because advance and delay change the bound on $x(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Insufficient information is available, so the rule cannot be classified.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "BIBO stable ($|y(t)| \\le 3M$).",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Use the same bound $|x(t)| \\le M$ on each shifted term, since shifts do not change magnitude. Then $|y(t)|=|2x(t-2)-x(t+3)| \\le 2|x(t-2)|+|x(t+3)| \\le 2M+M=3M$, which is finite for finite $M$.",
                "latex": "",
