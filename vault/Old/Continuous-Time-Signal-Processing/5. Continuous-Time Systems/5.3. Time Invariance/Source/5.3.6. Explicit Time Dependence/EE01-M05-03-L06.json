        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $T(x(t))=3t x(t)$ and shifted input $x(t-t_0)$, choose the correct pair $(T\\{x(t-t_0)\\},y(t-t_0))$ for this step.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T\\{x(t-t_0)\\}=3t x(t-t_0)$ and $y(t-t_0)=(t-t_0)x(t-t_0)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T\\{x(t-t_0)\\}=3t x(t)$ and $y(t-t_0)=(t-t_0)x(t-t_0)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T\\{x(t-t_0)\\}=3(t-t_0)x(t-t_0)$ and $y(t-t_0)=3t x(t-t_0)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T\\{x(t-t_0)\\}=3(t-t_0)x(t)$ and $y(t-t_0)=3(t-t_0)x(t-t_0)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$T\\{x(t-t_0)\\}=3t x(t-t_0)$ and $y(t-t_0)=(t-t_0)x(t-t_0)$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the shift-then-system path, substitute the shifted input into the same rule so the free multiplier stays $t$ and only the input argument shifts. For the system-then-shift path, replace $t$ with $t-t_0$ in $y(t)=3t x(t)$, so the factor becomes $t-t_0$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the explicit-time rule $T(x(t))=-2t x(t)$ with input shift by $t_0$, which expression matches the shifted output $y(t-t_0)$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t-t_0)=(-2)(t-t_0)x(t-t_0)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t-t_0)=-2t x(t-t_0)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t-t_0)=-2x(t-t_0)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t-t_0)=-2t x(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$y(t-t_0)=(-2)(t-t_0)x(t-t_0)$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The system output is $y(t)=-2t x(t)$. To form $y(t-t_0)$, replace $t$ by $t-t_0$ and the signal argument by $x(t-t_0)$, giving $y(t-t_0)=(-2)(t-t_0)x(t-t_0)$. Keeping $t$ unchanged is a common error for explicit-time rules.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
        "lesson_index": 6,
        "lesson_title": "Time-Varying Systems with Explicit $t$",
        "section_index": 3,
        "section_title": "Comparing Paths for a Time-Dependent Offset",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $T(x(t))=x(t)+2t$, compute the two time-invariance test paths for input shift $t_0$. Which option correctly states $T(x(t-t_0))$ and $y(t-t_0)$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T(x(t-t_0))=x(t-t_0)+2t$, $\\quad y(t-t_0)=x(t-t_0)+2(t-t_0)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T(x(t-t_0))=x(t-t_0)+2(t-t_0)$, $\\quad y(t-t_0)=x(t-t_0)+2t$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T(x(t+t_0))=x(t+t_0)+2t$, $\\quad y(t-t_0)=x(t-t_0)+2(t-t_0)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T(x(t-t_0))=x(t-t_0)+2t$, $\\quad y(t)=x(t)+2t$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "Choice A",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Shift-first substitution only changes the signal argument: $T(x(t-t_0))=x(t-t_0)+2t$. Shifting the full original output replaces every occurrence of $t$ by $t-t_0$, so $y(t-t_0)=x(t-t_0)+2(t-t_0)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $T(x(t))=x(t)-t$, compare the two-path results under $x(t-t_0)$. What is the correct pair?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T(x(t-t_0))=x(t-t_0)-t$, $\\quad y(t-t_0)=x(t-t_0)-(t-t_0)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
