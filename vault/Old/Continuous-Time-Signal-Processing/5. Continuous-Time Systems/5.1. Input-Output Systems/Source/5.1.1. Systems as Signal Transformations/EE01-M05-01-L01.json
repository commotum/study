        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $y(t)=\\int_{-\\infty}^{t} x(\\tau)d\\tau$, identify the correct input, output, and system mapping.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input: $x(t)$, output: $y(t)$, system mapping: $y(t)=T\\{x(t)\\}=\\int_{-\\infty}^{t}x(\\tau)d\\tau$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input: $y(t)$, output: $x(t)$, system mapping: $y(t)=T\\{x(t)\\}=\\int_{-\\infty}^{t}x(\\tau)d\\tau$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input: $x(t)$, output: $y(t)$, system is the symbol $y(t)$ itself.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input: $x(t)$, output: $x(t)$, system mapping: $T\\{x(t)\\}=\\int_{-\\infty}^{t}x(\\tau)d\\tau$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)$ equals the system and $x(t)$ is the system output, with no input-output direction.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "A",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The output is always the signal on the left side, so here the output is $y(t)$. The expression inside the right side is a functional transformation of the input signal, so the input is $x(t)$ and the system is the rule $T\\{\\cdot\\}$ mapping $x(t)$ to $\\int_{-\\infty}^{t}x(\\tau)d\\tau$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $v(t)=\\frac{d}{dt}u(t)+3u(t)$, pick the best input/output/system statement.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input: $u(t)$, output: $v(t)$, system mapping: $T\\{u(t)\\}=\\frac{d}{dt}u(t)+3u(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input: $v(t)$, output: $u(t)$, system mapping: $T\\{v(t)\\}=\\frac{d}{dt}u(t)+3u(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input: $u(t)$, output: $v(t)$, system is the symbol $\\frac{d}{dt}$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input: $v(t)$, output: $v(t)$, system mapping: $T\\{v(t)\\}=\\frac{d}{dt}u(t)+3u(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$v(t)=u(t)$ and the expression is just the value of a signal, not a transformation rule.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "A",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The same parsing rule applies: the left symbol is the output $v(t)$ and the signal transformed by the operator is the input $u(t)$. The system is the whole operator $\\frac{d}{dt}(\\cdot)+3(\\cdot)$, not the derivative symbol alone.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
        "lesson_index": 1,
        "lesson_title": "Systems as Signal Transformations",
        "section_index": 3,
        "section_title": "Applying a Simple System Rule to a Signal",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "If $T\\{x(t)\\}=x(t-2)$ and $x(t)=u(t)-u(t-4)$, which expression is the output $y(t)$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)=u(t-2)-u(t-6)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)=u(t+2)-u(t-2)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)=2\\,\\big(u(t-2)-u(t-6)\\big)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)=u(0)-u(2)$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)=u(t)-u(t-4)+2$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$y(t)=u(t-2)-u(t-6)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Use the same system rule on every argument of the input: replace $t$ by $t-2$ in both step terms, so $u(t)$ becomes $u(t-2)$ and $u(t-4)$ becomes $u((t-2)-4)=u(t-6)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "If $T\\{x(t)\\}=x(t+1)$ and $x(t)=e^{-t}$, which expression is the output $y(t)$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)=e^{-(t+1)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)=e^{-(t-1)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)=2e^{-(t+1)}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)=e^{-1}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y(t)=e^{t+1}$",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "$y(t)=e^{-(t+1)}$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "An advance by 1 keeps the rule unchanged and substitutes $t+1$ everywhere in the input, so $x(t)=e^{-t}$ becomes $x(t+1)=e^{-(t+1)}$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
