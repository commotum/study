    "section_count": 4,
    "sections": [
      {
        "lesson_index": 3,
        "lesson_title": "Continuous-Time System Notation",
        "section_index": 2,
        "section_title": "Identifying Input and Output in Arrow Notation",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Read $x(t) \\to y(t)=4x(t-1)-2$. Which statement correctly identifies the input, output, and direction?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input is $x(t)$, output is $y(t)$, direction is $x(t) \\to y(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input is $y(t)$, output is $x(t)$, direction is $y(t) \\to x(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input is $x(t-1)$, output is $y(t)$, direction is $x(t-1) \\to y(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input is $y(t)$, output is $x(t-1)$, direction is $y(t) \\to x(t-1)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input and output are the same symbol, so this is not a valid input-output notation.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "Input is $x(t)$ and output is $y(t)$ with direction $x(t) \\to y(t)$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "The arrow notation puts input on the left and output on the right, so $x(t)$ is the input and $y(t)$ is the output. The expression on the right shows how the input is transformed and does not change the direction.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Read $u(t) \\to v(t)=3u(t-\\tau)+5$. Which option is the correct input-output pair?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input is $v(t)$, output is $u(t)$, direction is $v(t) \\to u(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input is $u(t)$, output is $v(t)$, direction is $u(t) \\to v(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input is $u(t-\\tau)$, output is $v(t)$, direction is $u(t-\\tau) \\to v(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input is $5$, output is $v(t)$, direction is $5 \\to v(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Input and output cannot be identified because both are delayed by $\\tau$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "B"
            ],
            "correct_answer": "Input is $u(t)$ and output is $v(t)$; the arrow direction is $u(t) \\to v(t)$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "In arrow form, the symbol before $\\to$ is the input and the symbol after $\\to$ is the output. The delayed argument $u(t-\\tau)$ is still part of the output expression.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
        "lesson_index": 3,
        "lesson_title": "Continuous-Time System Notation",
        "section_index": 3,
        "section_title": "Identifying the System Operator in Operator Notation",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given $y(t)=T\\{x(t)\\}$ and $T\\{x(t)\\}=2x(t)$, which option best identifies the operator and the resulting system-map statement?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T\\{x(t)\\}=x(t-1)$, so the map is a one-unit delay.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T\\{x(t)\\}=\\int_{-\\infty}^{t}x(\\tau)d\\tau$, so it is an integral operator.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T$ is the gain-by-2 operator: $T\\{x(t)\\}=2x(t)$, so $y(t)=2x(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "D",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$x(t)$ is the operator and $T$ is the output, so $x(t)=2y(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "E",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T$ is identified by the output symbol alone: $y(t)=T$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "C"
            ],
            "correct_answer": "$T$ is the gain-by-2 operator, since $T\\{x(t)\\}=2x(t)$ and $y(t)=2x(t)$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "In operator notation, the braces term shows what the operator does to the input. Here, it multiplies the input by 2 and maps $x(t)$ to $y(t)=2x(t)$; the signal names do not get collapsed into the operator symbol itself.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given $y(t)=T\\{x(t)\\}$ and $T\\{x(t)\\}=x(t+2)$, which option correctly identifies the operator and input-output role?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T$ is the delay-by-one operator: $T\\{x(t)\\}=x(t-1)$ and so $y(t)=x(t-1)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T$ is an integration operator and $y(t)=\\int x(\\tau)d\\tau$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$T$ is a two-unit advance operator, so $y(t)=x(t+2)$ with input $x(t)$ and output $y(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "D",
                "choice_blocks": [
