                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "A"
            ],
            "correct_answer": "consistent",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "This is a direct pattern check. Keep the same scalar and sign structure, and map each input coefficient to its corresponding output coefficient.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "select-list",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given $T[x_1(t)] = y_1(t)$ and $T[x_2(t)] = y_2(t)$, classify the claim $T[2x_1(t)-3x_2(t)] = 2y_1(t)-y_2(t)$ by direct comparison.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Consistent, because the signs are the same and exact numeric values are not needed to verify a claimed form.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Inconsistent, because the coefficient on $y_2(t)$ should be $-3y_2(t)$ to match the input combination.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Not enough information, because you must first compute a new output from the system rule $T[\\cdot]$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "B"
            ],
            "correct_answer": "inconsistent",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Superposition gives $T[2x_1(t)-3x_2(t)] = 2T[x_1(t)]-3T[x_2(t)] = 2y_1(t)-3y_2(t)$, so the claim with $-y_2(t)$ is incorrect.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
        "lesson_index": 3,
        "lesson_title": "The Superposition Test",
        "section_index": 4,
        "section_title": "Recognizing When Superposition Fails",
        "step_type": "example",
        "question_type": "select-list",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "select-list",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $T[x(t)] = [x(t)]^2$, with $x_1(t) = 3$ and $x_2(t) = 4$, decide whether the system satisfies superposition for this pair by comparing $T[x_1(t)+x_2(t)]$ and $T[x_1(t)] + T[x_2(t)]$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Passes",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Fails",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Not enough information",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "B"
            ],
            "correct_answer": "Fails",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Compute the two sides: $T[x_1(t)+x_2(t)]=T[3+4]=[7]^2=49$. Also $T[x_1(t)]+T[x_2(t)]=T[3]+T[4]=3^2+4^2=25+16=41$. These are not equal, so superposition does not hold for this input pair.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "select-list",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For $T[x(t)] = [x(t)]^2$, with $x_1(t)=t$ and $x_2(t)=2$, decide whether the system passes superposition by checking $T[x_1(t)+x_2(t)]$ against $T[x_1(t)] + T[x_2(t)]$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Passes",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Fails",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "C",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Not enough information",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": false
              }
            ],
            "correct_choice_labels": [
              "B"
            ],
            "correct_answer": "Fails",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Compute the left side: $T[x_1(t)+x_2(t)] = T[t+2] = [t+2]^2 = t^2 + 4t + 4$. Compute the right side: $T[x_1(t)] + T[x_2(t)] = T[t] + T[2] = t^2 + 4$. The two expressions differ by the linear term $4t$, so superposition fails.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      }
    ]
