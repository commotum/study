        "questions": [
          {
            "question_index": 1,
            "question_type": "free-response",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "If $T[x_1(t)] = y_1(t)$ and $T[x_2(t)] = y_2(t)$, what is $T[2x_1(t)-3x_2(t)]$?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "$T[2x_1(t)-3x_2(t)] = 2y_1(t)-3y_2(t)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Use superposition to separate each scaled input, then apply homogeneity to each part: $T[2x_1(t)] = 2T[x_1(t)] = 2y_1(t)$ and $T[-3x_2(t)] = -3T[x_2(t)] = -3y_2(t)$. Recombining gives $T[2x_1(t)-3x_2(t)] = 2y_1(t)-3y_2(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "free-response",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Given $T[x_1(t)] = y_1(t)$ and $T[x_2(t)] = y_2(t)$, predict $T[4x_2(t)-x_1(t)]$.",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "$T[4x_2(t)-x_1(t)] = 4y_2(t)-y_1(t)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Swap of labels is fine because the rule applies term-by-term. Split the input as $4x_2(t)$ and $-x_1(t)$, then move coefficients to the outputs: $T[4x_2(t)] = 4y_2(t)$ and $T[-x_1(t)] = -y_1(t)$. The result is $4y_2(t)-y_1(t)$.",
                "latex": "",
                "image_slot_id": ""
              }
            ]
          }
        ]
      },
      {
        "lesson_index": 3,
        "lesson_title": "The Superposition Test",
        "section_index": 3,
        "section_title": "Verifying a Claimed Combined-Input Output",
        "step_type": "example",
        "question_type": "select-list",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "select-list",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "If $T[x_1(t)] = y_1(t)$ and $T[x_2(t)] = y_2(t)$, test the claim $T[2x_1(t)-x_2(t)] = 2y_1(t)-y_2(t)$. Which best reflects the superposition check?",
                "latex": "",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "Consistent, because superposition predicts $T[2x_1(t)-x_2(t)] = 2T[x_1(t)] - T[x_2(t)] = 2y_1(t)-y_2(t)$.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
