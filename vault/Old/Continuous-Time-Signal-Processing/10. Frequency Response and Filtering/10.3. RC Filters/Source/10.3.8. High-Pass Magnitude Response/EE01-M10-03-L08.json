                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\begin{aligned}|H(j\\omega)|&=\\frac{\\omega RC}{\\sqrt{1+(\\omega RC)^2}}\\\\&\\approx\\frac{\\omega RC}{\\omega RC}=1\\end{aligned}",
