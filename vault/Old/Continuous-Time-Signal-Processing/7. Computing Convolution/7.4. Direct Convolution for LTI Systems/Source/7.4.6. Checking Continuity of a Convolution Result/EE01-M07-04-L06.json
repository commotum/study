      {
        "lesson_index": 6,
        "lesson_title": "Checking Continuity of a Convolution Result",
        "section_index": 3,
        "section_title": "Checking an Interior Boundary Between Two Nonzero Pieces",
        "step_type": "example",
        "question_type": "multiple-choice",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "multiple-choice",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the piecewise result below, which statement correctly checks continuity at $t = 3$?",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "y(t)=\\begin{cases}\nt-1, & 1\\le t<3,\\\\\n5-t, & 3\\le t<5\n\\end{cases}",
                "image_slot_id": ""
              }
            ],
            "choices": [
              {
                "choice_label": "A",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y_left(3)=3-1=2$ and $y_right(3)=5-3=2$, so the check passes.",
                    "latex": "",
                    "image_slot_id": ""
                  }
                ],
                "is_correct": true
              },
              {
                "choice_label": "B",
                "choice_blocks": [
                  {
                    "block_type": "paragraph",
                    "text": "$y_left(1)=1-1=0$ and $y_right(3)=5-3=2$, so the check fails.",
