      {
        "lesson_index": 5,
        "lesson_title": "Unequal-Exponent Exponential Convolution",
        "section_index": 3,
        "section_title": "Multiplying Unequal Exponential Terms Inside the Integral",
        "step_type": "example",
        "question_type": "free-response",
        "answer_cardinality": "single",
        "content_mode": "symbolic-only",
        "image_slots": [],
        "question_count": 2,
        "questions": [
          {
            "question_index": 1,
            "question_type": "free-response",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the signals below, simplify $x(\\tau)$$h(t - \\tau)$ on the overlap interval $0 \\le \\tau \\le t$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "x(t)=e^{-3t}u(t),\\qquad h(t)=e^{-7t}u(t)",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "The simplified product is $e^{-7t}$$e^{4tau}$.",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "On the overlap interval, use the exponential parts of $x(\\tau)$ and $h(t - \\tau)$. First distribute the shifted exponent.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "x(\\tau)h(t-\\tau)=e^{-3\\tau}e^{-7(t-\\tau)}=e^{-3\\tau}e^{-7t+7\\tau}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "Combine the $\\tau$ exponents and keep the t-only factor separate.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "e^{-3\\tau}e^{-7t+7\\tau}=e^{-7t}e^{4\\tau}",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "free-response",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "For the signals below, simplify $x(\\tau)$$h(t - \\tau)$ on the overlap interval $0 \\le \\tau \\le t$.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "x(t)=e^{-5t}u(t),\\qquad h(t)=e^{-2t}u(t)",
