            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Compute the convolution of the two signals.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "x(t)=5e^{-3t}u(t),\\qquad h(t)=2e^{-3t}u(t)",
                "image_slot_id": ""
              }
            ],
            "choices": [],
            "correct_choice_labels": [],
            "correct_answer": "(x*h)(t)=10t $e^{-3t}$$u(t)$",
            "answer_explanation_blocks": [
              {
                "block_type": "paragraph",
                "text": "Use the equal-exponent causal setup and carry the leading constants through the integral.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "(x*h)(t)=u(t)\\int_0^t \\left(5e^{-3\\tau}\\right)\\left(2e^{-3(t-\\tau)}\\right)\\,d\\tau",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "The scale factors multiply to 10, and the repeated exponent makes the $\\tau$ terms cancel.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "\\left(5e^{-3\\tau}\\right)\\left(2e^{-3(t-\\tau)}\\right)=10e^{-3\\tau-3t+3\\tau}=10e^{-3t}",
                "image_slot_id": ""
              },
              {
                "block_type": "paragraph",
                "text": "The remaining integrand is constant with respect to $\\tau$, so integrating from 0 to t multiplies it by t.",
                "latex": "",
                "image_slot_id": ""
              },
              {
                "block_type": "display-math",
                "text": "",
                "latex": "(x*h)(t)=u(t)\\int_0^t 10e^{-3t}\\,d\\tau=10t e^{-3t}u(t)",
                "image_slot_id": ""
              }
            ]
          },
          {
            "question_index": 2,
            "question_type": "free-response",
            "answer_cardinality": "single",
            "prompt_blocks": [
              {
                "block_type": "paragraph",
                "text": "Compute the convolution of the two signals.",
