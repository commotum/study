{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Obsidian Quiz Block Subset",
  "description": "Canonical lesson-authoring subset. It intentionally rejects legacy input aliases and applies stronger content/cardinality rules than the plugin runtime.",
  "oneOf": [
    { "$ref": "#/$defs/radio" },
    { "$ref": "#/$defs/checkbox" },
    { "$ref": "#/$defs/blank" },
    { "$ref": "#/$defs/free" },
    { "$ref": "#/$defs/select" },
    { "$ref": "#/$defs/multiSelect" },
    { "$ref": "#/$defs/noodle" }
  ],
  "$defs": {
    "text": {
      "type": ["string", "number", "boolean"],
      "minLength": 1
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "id": { "type": "string" },
        "content": { "$ref": "#/$defs/text" },
        "correct": { "type": "boolean" },
        "feedback": { "$ref": "#/$defs/text" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "correct_option"],
      "properties": {
        "id": { "type": "string" },
        "content": { "$ref": "#/$defs/text" },
        "correct_option": { "type": "string" },
        "feedback": { "$ref": "#/$defs/text" }
      }
    },
    "multiQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "correct_option", "options"],
      "properties": {
        "id": { "type": "string" },
        "content": { "$ref": "#/$defs/text" },
        "correct_option": { "type": "string" },
        "feedback": { "$ref": "#/$defs/text" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "radio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content", "options"],
      "properties": {
        "type": { "const": "radio" },
        "id": { "type": "string" },
        "content": { "$ref": "#/$defs/text" },
        "gated": { "type": "boolean" },
        "shuffle": { "type": "boolean" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "checkbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content", "options"],
      "properties": {
        "type": { "const": "checkbox" },
        "id": { "type": "string" },
        "content": { "$ref": "#/$defs/text" },
        "gated": { "type": "boolean" },
        "shuffle": { "type": "boolean" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "blank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "blank" },
        "id": { "type": "string" },
        "require_exact": { "type": "boolean" },
        "content": { "$ref": "#/$defs/text" },
        "gated": { "type": "boolean" },
        "shuffle": { "type": "boolean" },
        "feedback": { "$ref": "#/$defs/text" }
      }
    },
    "free": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "free" },
        "id": { "type": "string" },
        "content": { "$ref": "#/$defs/text" },
        "gated": { "type": "boolean" },
        "shuffle": { "type": "boolean" },
        "correct": { "$ref": "#/$defs/text" },
        "feedback": { "$ref": "#/$defs/text" }
      }
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content", "options", "questions"],
      "properties": {
        "type": { "const": "select" },
        "id": { "type": "string" },
        "content": { "$ref": "#/$defs/text" },
        "gated": { "type": "boolean" },
        "shuffle": { "type": "boolean" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/option" }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "multiSelect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content", "questions"],
      "properties": {
        "type": { "const": "multi-select" },
        "id": { "type": "string" },
        "content": { "$ref": "#/$defs/text" },
        "gated": { "type": "boolean" },
        "shuffle": { "type": "boolean" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/multiQuestion" }
        }
      }
    },
    "noodle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content", "options", "questions"],
      "properties": {
        "type": { "const": "noodle" },
        "id": { "type": "string" },
        "content": { "$ref": "#/$defs/text" },
        "gated": { "type": "boolean" },
        "shuffle": { "type": "boolean" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/option" }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    }
  }
}
